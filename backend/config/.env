# 数据库配置
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=lease_contract

# SQLite配置（本地开发测试用）
SQLITE_PATH=./data/lease_contract.db

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 服务器配置
PORT=3000
NODE_ENV=development

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
