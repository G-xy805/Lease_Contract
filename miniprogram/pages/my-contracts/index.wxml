<!-- pages/my-contracts/index.wxml - 我的合同页（v2重构版 - TabBar页面） -->
<view class="container">
  <!-- 顶部欢迎语 -->
  <view class="header-wrapper">
    <view class="header-content">
      <text class="welcome-text">欢迎查看合同</text>
      <text class="sub-welcome-text">您的电子合同列表</text>
    </view>
  </view>

  <!-- 筛选Tab -->
  <van-tabs
    active="{{ activeTab }}"
    bind:change="onTabChange"
    color="var(--primary-color)"
    line-width="40rpx"
    sticky
    scroll-top="0"
  >
    <van-tab wx:for="{{tabs}}" wx:key="name" title="{{item.title}}" name="{{item.name}}"></van-tab>
  </van-tabs>

  <!-- 骨架屏 - 首次加载 -->
  <view class="skeleton-container" wx:if="{{skeletonLoading && !refreshing}}">
    <view class="skeleton-list">
      <view class="skeleton-item" wx:for="{{[1,2,3]}}" wx:key="index">
        <van-skeleton title avatar row="2" />
      </view>
    </view>
  </view>

  <scroll-view
    scroll-y
    enable-back-to-top
    bindscrolltolower="onReachBottom"
    class="contract-scroll"
    wx:if="{{!skeletonLoading}}"
  >
    <!-- 下拉刷新指示器 -->
    <view class="refresh-wrapper" wx:if="{{refreshing}}">
      <van-loading-dots type="primary" />
      <text class="refresh-text">刷新中...</text>
    </view>

    <!-- 合同列表 - 使用 contract-card 组件 -->
    <view class="contract-list" wx:if="{{contracts.length > 0}}">
      <view
        wx:for="{{contracts}}"
        wx:key="id"
        class="contract-item-wrapper"
        bindtap="goToContractDetail"
        data-id="{{item.id}}"
      >
        <contract-card contract="{{item}}" />
      </view>
    </view>

    <!-- 空状态 - 使用 empty-state 组件 -->
    <empty-state
      wx:if="{{!contracts.length && !loading && !refreshing}}"
      image="search"
      title="{{getEmptyConfig().text}}"
      description="{{getEmptyConfig().subText}}"
    />

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{contracts.length > 0}}">
      <van-loading size="24rpx" wx:if="{{loadingMore}}" color="var(--primary-color)">
        <text class="loading-text">加载中...</text>
      </van-loading>
      <view class="no-more-wrapper" wx:if="{{!loadingMore && !hasMore}}">
        <view class="no-more-line"></view>
        <text class="no-more-text">没有更多了</text>
        <view class="no-more-line"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 全局加载状态 -->
  <view class="global-loading-mask" wx:if="{{loading && !refreshing && !skeletonLoading && !contracts.length}}">
    <van-loading type="spinner" size="50rpx" color="var(--primary-color)" />
    <text class="loading-text">加载中...</text>
  </view>
</view>
