<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">合同列表</text>
    <text class="page-subtitle">管理您的所有合同</text>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-section">
    <van-tabs
      active="{{activeTab}}"
      bind:change="onTabChange"
      sticky
      line-width="48rpx"
      line-height="6rpx"
      active-color="var(--primary-color)"
      inactive-color="var(--text-color-tertiary)"
      animated
      swipeable
    >
      <van-tab title="全部" name="all" />
      <van-tab title="待签署" name="pending" />
      <van-tab title="已签署" name="signed" />
      <van-tab title="已拒绝" name="rejected" />
      <van-tab title="已取消" name="cancelled" />
    </van-tabs>
  </view>

  <!-- 合同列表 -->
  <view class="contract-list" wx:if="{{contracts.length > 0}}">
    <view
      wx:for="{{contracts}}"
      wx:key="id"
      class="contract-item interactive"
      bindtap="goToContractDetail"
      data-id="{{item.id}}"
    >
      <!-- 左侧状态指示条 -->
      <view class="status-indicator status-{{item.status}}"></view>

      <!-- 中间内容 -->
      <view class="contract-main">
        <view class="contract-header">
          <text class="contract-title text-ellipsis">{{item.title}}</text>
          <van-tag
            type="{{item.status === 3 ? 'success' : item.status === 2 ? 'warning' : item.status === 4 ? 'danger' : 'default'}}"
            size="small"
            class="status-tag-{{item.status}}"
          >
            {{item.statusText}}
          </van-tag>
        </view>

        <view class="contract-info">
          <view class="info-row">
            <van-icon name="location-o" size="28rpx" class="info-icon" />
            <text class="info-text text-ellipsis">{{item.houseAddress || '未填写地址'}}</text>
          </view>
          <view class="info-row">
            <van-icon name="clock-o" size="28rpx" class="info-icon" />
            <text class="info-text">{{item.leaseStart}} ~ {{item.leaseEnd}}</text>
          </view>
        </view>

        <view class="contract-footer">
          <view class="contract-amount">
            <text class="amount-label">月租金</text>
            <text class="amount-value">¥{{item.monthlyRent}}</text>
          </view>
          <view class="contract-date">
            <text class="date-text">{{item.updateTime}}</text>
          </view>
        </view>
      </view>

      <!-- 右侧箭头 -->
      <view class="contract-arrow">
        <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && contracts.length === 0}}" class="empty-state">
    <view class="empty-illustration">
      <van-empty
        image="default"
        description="{{emptyText}}"
      />
    </view>
    <van-button
      wx:if="{{activeTab === 'all'}}"
      type="primary"
      round
      size="large"
      bind:click="goToCreateContract"
      class="empty-action-btn"
    >
      <van-icon name="plus" class="btn-icon" />
      创建合同
    </van-button>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <van-loading type="spinner" size="60rpx" color="var(--primary-color)" vertical>加载中...</van-loading>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>