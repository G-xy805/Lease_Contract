<!-- pages/contracts/index.wxml - 合同列表页（v2重构版） -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">合同列表</text>
    <text class="page-subtitle">管理您的所有合同</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-section">
    <van-search
      value="{{ keyword }}"
      placeholder="搜索房屋地址、甲方/乙方名称"
      bind:change="onSearchInput"
      bind:search="onSearch"
      bind:clear="onClearSearch"
      shape="round"
      background="transparent"
      custom-class="search-input"
    />
  </view>

  <!-- 状态筛选 -->
  <view class="filter-section">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="filter-scroll">
      <view class="filter-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="index"
          class="filter-tab {{activeTab === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onTabChange"
        >
          <status-tag
            type="{{activeTab === index ? 'primary' : 'default'}}"
            text="{{item.title}}"
            size="small"
          />
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 合同列表 - 使用 contract-card 组件 -->
  <view class="contract-list" wx:if="{{contracts.length > 0}}">
    <view
      wx:for="{{contracts}}"
      wx:key="id"
      class="contract-item-wrapper"
      bindtap="goToContractDetail"
      data-id="{{item.id}}"
    >
      <contract-card
        contract="{{item}}"
      />
    </view>
  </view>

  <!-- 空状态 - 使用 empty-state 组件 -->
  <empty-state
    wx:if="{{!loading && contracts.length === 0}}"
    image="search"
    title="{{keyword ? '未找到相关合同' : '暂无合同'}}"
    description="{{keyword ? '换个关键词试试吧' : '您的合同将显示在这里'}}"
  >
    <van-button
      wx:if="{{!keyword && activeTab === 0}}"
      type="primary"
      round
      size="large"
      bind:click="goToCreateContract"
      class="empty-action-btn"
    >
      创建第一个合同
    </van-button>
  </empty-state>

  <!-- 加载更多指示器 -->
  <view class="load-more-wrapper" wx:if="{{contracts.length > 0}}">
    <van-loading size="24rpx" wx:if="{{loadingMore}}" color="var(--primary-color)">
      <text class="load-more-text">加载中...</text>
    </van-loading>
    <view class="no-more" wx:if="{{!loadingMore && !hasMore}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>
  </view>

  <!-- 全局加载状态 -->
  <view class="loading-overlay" wx:if="{{loading && !refreshing && !loadingMore && contracts.length === 0}}">
    <van-loading type="spinner" size="60rpx" color="var(--primary-color)" vertical>
      加载中...
    </van-loading>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>
