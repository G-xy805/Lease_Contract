<wxs module="utils">
function formatDate(dateStr) {
  if (!dateStr) return ''
  var date = dateStr
  if (typeof date === 'string' && date.indexOf('-') > -1) {
    var parts = date.split('-')
    if (parts.length === 3) {
      return parts[0] + '年' + parseInt(parts[1]) + '月' + parseInt(parts[2]) + '日'
    }
  }
  return dateStr
}

function getPaymentMethodText(value) {
  var map1 = '月付'
  var map3 = '季付'
  var map6 = '半年付'
  var map12 = '年付'
  if (value === 1) return map1
  if (value === 3) return map3
  if (value === 6) return map6
  if (value === 12) return map12
  return map1
}

module.exports = {
  formatDate: formatDate,
  getPaymentMethodText: getPaymentMethodText
}
</wxs>

<!-- pages/create-contract/index.wxml -->
<view class="container">
  <van-notice-bar text="请填写完整的合同信息，带*号为必填项" />

  <scroll-view scroll-y class="form-scroll">
    <!-- 步骤指示器 -->
    <view class="steps-wrapper">
      <view class="steps-custom">
        <view
          wx:for="{{steps}}"
          wx:key="index"
          class="step-item {{index < currentStep ? 'completed' : index === currentStep ? 'active' : ''}}"
        >
          <view class="step-connector" wx:if="{{index > 0}}"></view>
          <view class="step-dot-wrapper">
            <view class="step-dot">
              <van-icon wx:if="{{index < currentStep}}" name="passed" size="28rpx" color="#ffffff" />
              <text wx:else>{{index + 1}}</text>
            </view>
          </view>
          <text class="step-label">{{item.title}}</text>
        </view>
      </view>
    </view>

    <!-- ========== Step 1: 甲方信息 ========== -->
    <view class="section {{currentStep === 0 ? 'active' : ''}}" wx:if="{{currentStep === 0}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="user-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">一、甲方信息</view>
        <view class="section-subtitle">出租方信息</view>
      </view>

      <van-field
        label="甲方名称"
        placeholder="请输入甲方公司/个人名称"
        value="{{formData.partyA_company}}"
        data-field="partyA_company"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        error="{{errors.partyA_company ? true : false}}"
        error-message="{{errors.partyA_company}}"
        class="form-field"
      />
      <van-field
        label="甲方电话"
        placeholder="请输入甲方联系电话"
        value="{{formData.partyA_phone}}"
        data-field="partyA_phone"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="number"
        maxlength="11"
        error="{{errors.partyA_phone ? true : false}}"
        error-message="{{errors.partyA_phone}}"
        class="form-field"
      />
      <van-field
        label="甲方备用电话"
        placeholder="请输入备用联系电话（选填）"
        value="{{formData.partyA_phone2}}"
        data-field="partyA_phone2"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="number"
        maxlength="11"
        class="form-field"
      />
      <van-field
        label="甲方委托代理人"
        placeholder="请输入代理人姓名（选填）"
        value="{{formData.partyA_contact}}"
        data-field="partyA_contact"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        class="form-field"
      />
      <van-field
        label="甲方收款账户"
        placeholder="请输入收款账户（选填）"
        value="{{formData.partyA_account}}"
        data-field="partyA_account"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        class="form-field"
      />
      <van-field
        label="甲方身份证"
        placeholder="请输入甲方身份证号（选填）"
        value="{{formData.partyA_idcard}}"
        data-field="partyA_idcard"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="idcard"
        maxlength="18"
        error="{{errors.partyA_idcard ? true : false}}"
        error-message="{{errors.partyA_idcard}}"
        class="form-field"
      />
      <view class="info-tip">
        <van-icon name="info-o" size="28rpx" class="tip-icon" />
        <text>甲方信息将自动填充当前用户信息</text>
      </view>
    </view>

    <!-- ========== Step 2: 乙方信息 ========== -->
    <view class="section {{currentStep === 1 ? 'active' : ''}}" wx:if="{{currentStep === 1}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="friends-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">二、乙方信息</view>
        <view class="section-subtitle">承租方信息</view>
      </view>

      <van-field
        label="乙方姓名"
        placeholder="请输入承租方姓名"
        value="{{formData.partyB_name}}"
        data-field="partyB_name"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        error="{{errors.partyB_name ? true : false}}"
        error-message="{{errors.partyB_name}}"
        class="form-field"
      />
      <van-field
        label="乙方电话"
        placeholder="请输入承租方联系电话"
        value="{{formData.partyB_phone}}"
        data-field="partyB_phone"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="number"
        maxlength="11"
        error="{{errors.partyB_phone ? true : false}}"
        error-message="{{errors.partyB_phone}}"
        class="form-field"
      />
      <van-field
        label="乙方身份证"
        placeholder="请输入18位身份证号"
        value="{{formData.partyB_idCard}}"
        data-field="partyB_idCard"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="idcard"
        maxlength="18"
        error="{{errors.partyB_idCard ? true : false}}"
        error-message="{{errors.partyB_idCard}}"
        class="form-field"
      />
      <van-field
        label="乙方联系人"
        placeholder="请输入联系人姓名（选填）"
        value="{{formData.partyB_contact}}"
        data-field="partyB_contact"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        class="form-field"
      />
    </view>

    <!-- ========== Step 3: 房屋信息 ========== -->
    <view class="section {{currentStep === 2 ? 'active' : ''}}" wx:if="{{currentStep === 2}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="home-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">三、房屋信息</view>
        <view class="section-subtitle">租赁房屋详情</view>
      </view>

      <van-field
        label="房屋地址"
        placeholder="请输入房屋详细地址"
        value="{{formData.house_address}}"
        data-field="house_address"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        error="{{errors.house_address ? true : false}}"
        error-message="{{errors.house_address}}"
        class="form-field"
      />
      <van-field
        label="房屋面积"
        placeholder="请输入面积（平方米）"
        value="{{formData.house_area}}"
        data-field="house_area"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="㎡"
        class="form-field"
      />
      <view class="picker-cell {{errors.rent_purpose ? 'error' : ''}}" bindtap="showPurposePicker">
        <text class="picker-label">租赁用途</text>
        <view class="picker-value-wrapper">
          <text class="{{formData.rent_purpose ? 'picker-value' : 'picker-placeholder'}}">{{formData.rent_purpose || '请选择'}}</text>
          <van-icon name="arrow" class="picker-arrow" />
        </view>
      </view>
    </view>

    <!-- ========== Step 4: 租赁期限 ========== -->
    <view class="section {{currentStep === 3 ? 'active' : ''}}" wx:if="{{currentStep === 3}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="clock-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">四、租赁期限</view>
        <view class="section-subtitle">合同时间范围</view>
      </view>

      <view class="picker-cell {{errors.lease_start ? 'error' : ''}}" bindtap="showStartDatePickerModal">
        <text class="picker-label required">租赁开始日期</text>
        <view class="picker-value-wrapper">
          <text class="{{formData.lease_start ? 'picker-value' : 'picker-placeholder'}}">{{formData.lease_start || '请选择'}}</text>
          <van-icon name="arrow" class="picker-arrow" />
        </view>
      </view>

      <view class="picker-cell {{errors.lease_end ? 'error' : ''}}" bindtap="showEndDatePickerModal">
        <text class="picker-label required">租赁结束日期</text>
        <view class="picker-value-wrapper">
          <text class="{{formData.lease_end ? 'picker-value' : 'picker-placeholder'}}">{{formData.lease_end || '请选择'}}</text>
          <van-icon name="arrow" class="picker-arrow" />
        </view>
      </view>

      <van-field
        label="租赁月数"
        placeholder="请输入租赁月数"
        value="{{formData.lease_months}}"
        data-field="lease_months"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="number"
        error="{{errors.lease_months ? true : false}}"
        error-message="{{errors.lease_months}}"
        class="form-field"
      />

      <van-field
        label="提前通知天数"
        placeholder="如：30天"
        value="{{formData.advance_notice_days}}"
        data-field="advance_notice_days"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="number"
        suffix="天"
        class="form-field"
      />
    </view>

    <!-- ========== Step 5: 租金信息 ========== -->
    <view class="section {{currentStep === 4 ? 'active' : ''}}" wx:if="{{currentStep === 4}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="cash-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">五、租金信息</view>
        <view class="section-subtitle">费用及支付方式</view>
      </view>

      <van-field
        label="月租金"
        placeholder="请输入每月租金"
        value="{{formData.monthly_rent}}"
        data-field="monthly_rent"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="digit"
        suffix="元/月"
        error="{{errors.monthly_rent ? true : false}}"
        error-message="{{errors.monthly_rent}}"
        class="form-field"
      />

      <view class="picker-cell" bindtap="showPaymentMethodPicker">
        <text class="picker-label">支付方式</text>
        <view class="picker-value-wrapper">
          <text class="{{formData.payment_method ? 'picker-value' : 'picker-placeholder'}}">{{utils.getPaymentMethodText(formData.payment_method)}}</text>
          <van-icon name="arrow" class="picker-arrow" />
        </view>
      </view>

      <van-field
        label="押金"
        placeholder="请输入押金金额"
        value="{{formData.deposit}}"
        data-field="deposit"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        required
        size="large"
        type="digit"
        suffix="元"
        error="{{errors.deposit ? true : false}}"
        error-message="{{errors.deposit}}"
        class="form-field"
      />
      <van-field
        label="押金（大写）"
        placeholder="自动转换"
        value="{{formData.deposit_chinese}}"
        disabled
        size="large"
        class="form-field disabled-field"
      />

      <van-field
        label="合同总金额"
        placeholder="自动计算"
        value="{{formData.total_amount}}"
        disabled
        size="large"
        type="digit"
        suffix="元"
        class="form-field disabled-field total-field"
      />
      <view class="calc-tip">
        <van-icon name="info-o" size="24rpx" />
        <text>合同总金额 = 月租金 x 租赁月数</text>
      </view>

      <view class="section-divider">
        <text class="divider-text">付款详情</text>
      </view>

      <view class="payment-hint">
        <van-icon name="info-o" size="28rpx" />
        <text>根据合同模板，最多支持分四次支付。填写"分几次支付"后，系统将自动显示对应的输入框。</text>
      </view>

      <van-field
        label="分几次支付"
        placeholder="请输入次数（1-4次）"
        value="{{formData.payment_count}}"
        data-field="payment_count"
        bind:change="onPaymentCountChange"
        size="large"
        type="number"
        suffix="次"
        class="form-field"
      />

      <van-field
        label="每几月支付"
        placeholder="每几个月支付一次"
        value="{{formData.payment_cycle}}"
        data-field="payment_cycle"
        bind:change="onFieldChange"
        size="large"
        type="number"
        suffix="月"
        class="form-field"
      />

      <!-- 第一次支付（始终显示） -->
      <view class="payment-item">
        <view class="payment-item-header">
          <text class="payment-item-title">第一次支付</text>
          <text class="payment-item-tip">签合同当日支付</text>
        </view>
        <van-field
          placeholder="首次支付金额"
          value="{{formData.first_payment_amount}}"
          data-field="first_payment_amount"
          bind:change="onFieldChange"
          size="large"
          type="digit"
          suffix="元"
          class="form-field"
        />
      </view>

      <!-- 第二次支付（payment_count >= 2 时显示） -->
      <view class="payment-item" wx:if="{{formData.payment_count >= 2}}">
        <view class="payment-item-header">
          <text class="payment-item-title">第二次支付</text>
          <text class="payment-item-tip">填写支付日期和金额</text>
        </view>
        <view class="picker-cell" bindtap="showSecondPaymentDatePicker">
          <text class="picker-label">第二次日期</text>
          <view class="picker-value-wrapper">
            <text class="{{formData.second_payment_date ? 'picker-value' : 'picker-placeholder'}}">{{formData.second_payment_date || '请选择日期'}}</text>
            <van-icon name="arrow" class="picker-arrow" />
          </view>
        </view>
        <van-field
          label="第二次金额"
          placeholder="第二次支付金额"
          value="{{formData.second_payment_amount}}"
          data-field="second_payment_amount"
          bind:change="onFieldChange"
          size="large"
          type="digit"
          suffix="元"
          class="form-field"
        />
      </view>

      <!-- 第三次支付（payment_count >= 3 时显示） -->
      <view class="payment-item" wx:if="{{formData.payment_count >= 3}}">
        <view class="payment-item-header">
          <text class="payment-item-title">第三次支付</text>
          <text class="payment-item-tip">以此类推每 N 月支付一次</text>
        </view>
        <van-field
          placeholder="第三次支付金额"
          value="{{formData.third_payment_amount}}"
          data-field="third_payment_amount"
          bind:change="onFieldChange"
          size="large"
          type="digit"
          suffix="元"
          class="form-field"
        />
      </view>

      <!-- 第四次支付（payment_count >= 4 时显示） -->
      <view class="payment-item" wx:if="{{formData.payment_count >= 4}}">
        <view class="payment-item-header">
          <text class="payment-item-title">第四次支付</text>
          <text class="payment-item-tip">最后一次支付</text>
        </view>
        <van-field
          placeholder="第四次支付金额"
          value="{{formData.fourth_payment_amount}}"
          data-field="fourth_payment_amount"
          bind:change="onFieldChange"
          size="large"
          type="digit"
          suffix="元"
          class="form-field"
        />
      </view>
    </view>

    <!-- ========== Step 6: 费用约定 ========== -->
    <view class="section {{currentStep === 5 ? 'active' : ''}}" wx:if="{{currentStep === 5}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="bill-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">六、费用约定</view>
        <view class="section-subtitle">水、电、燃气等费用</view>
      </view>
      <view class="fee-tip">请勾选约定由乙方承担的费用：</view>

      <view class="fee-list">
        <view class="fee-item interactive" wx:for="{{feeOptions}}" wx:key="name">
          <view class="fee-item-left">
            <van-icon name="{{item.icon}}" size="36rpx" class="fee-icon" />
            <text class="fee-name">{{item.name}}</text>
          </view>
          <van-checkbox value="{{item.checked}}" bind:change="onFeeChange" data-index="{{index}}"></van-checkbox>
        </view>
      </view>
    </view>

    <!-- ========== Step 7: 居间服务费 ========== -->
    <view class="section {{currentStep === 6 ? 'active' : ''}}" wx:if="{{currentStep === 6}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="balance-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">七、居间服务费</view>
        <view class="section-subtitle">如有中介服务</view>
      </view>
      <view class="fee-tip">请填写居间服务佣金（如有）：</view>

      <van-field
        label="甲方佣金"
        placeholder="请输入甲方佣金金额（选填）"
        value="{{formData.partyA_commission}}"
        data-field="partyA_commission"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="元"
        class="form-field"
      />
      <van-field
        label="甲方佣金（大写）"
        placeholder="自动转换"
        value="{{formData.partyA_commission_chinese}}"
        disabled
        size="large"
        class="form-field disabled-field"
      />

      <van-field
        label="乙方佣金"
        placeholder="请输入乙方佣金金额（选填）"
        value="{{formData.partyB_commission}}"
        data-field="partyB_commission"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="元"
        class="form-field"
      />
      <van-field
        label="乙方佣金（大写）"
        placeholder="自动转换"
        value="{{formData.partyB_commission_chinese}}"
        disabled
        size="large"
        class="form-field disabled-field"
      />
    </view>

    <!-- ========== Step 8: 水电表读数 ========== -->
    <view class="section {{currentStep === 7 ? 'active' : ''}}" wx:if="{{currentStep === 7}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="chart-trending-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">八、水电表读数</view>
        <view class="section-subtitle">租赁开始时的表数</view>
      </view>
      <view class="fee-tip">请填写租赁开始时的水电燃气表读数：</view>

      <van-field
        label="电表读数"
        placeholder="请输入电表读数（选填）"
        value="{{formData.electricity_meter}}"
        data-field="electricity_meter"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="度"
        class="form-field"
      />

      <van-field
        label="水表读数"
        placeholder="请输入水表读数（选填）"
        value="{{formData.water_meter}}"
        data-field="water_meter"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="吨"
        class="form-field"
      />

      <van-field
        label="燃气表读数"
        placeholder="请输入燃气表读数（选填）"
        value="{{formData.gas_meter}}"
        data-field="gas_meter"
        bind:change="onFieldChange"
        bind:blur="onFieldBlur"
        size="large"
        type="digit"
        suffix="方"
        class="form-field"
      />
    </view>

    <!-- ========== Step 9: 物品清单 ========== -->
    <view class="section {{currentStep === 8 ? 'active' : ''}}" wx:if="{{currentStep === 8}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="orders-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">九、物品清单</view>
        <view class="section-subtitle">房屋内设施设备</view>
      </view>
      <view class="fee-tip">请填写租赁房屋内的物品数量（数量为0或不填则不显示在合同中）：</view>

      <!-- 预定义物品列表 -->
      <view class="inventory-grid">
        <view class="inventory-grid-item" wx:for="{{inventoryOptions}}" wx:key="name">
          <view class="inventory-grid-info">
            <text class="inventory-grid-name">{{item.name}}</text>
            <text class="inventory-grid-unit">单位: {{item.unit}}</text>
          </view>
          <view class="inventory-grid-input">
            <van-stepper
              value="{{inventoryQuantities[item.templateField] || 0}}"
              min="0"
              max="99"
              data-field="{{item.templateField}}"
              data-name="{{item.name}}"
              data-unit="{{item.unit}}"
              bind:change="onInventoryStepperChange"
              theme="round"
            />
          </view>
        </view>
      </view>

      <!-- 已添加的物品摘要 -->
      <view class="inventory-summary" wx:if="{{inventorySummary.length > 0}}">
        <view class="inventory-summary-title">已添加物品 ({{inventorySummary.length}}项)</view>
        <view class="inventory-summary-list">
          <view class="inventory-summary-item" wx:for="{{inventorySummary}}" wx:key="name">
            <text class="summary-item-name">{{item.name}}</text>
            <text class="summary-item-qty">{{item.quantity}} {{item.unit}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== Step 10: 备注 ========== -->
    <view class="section {{currentStep === 9 ? 'active' : ''}}" wx:if="{{currentStep === 9}}">
      <view class="section-header">
        <view class="section-icon">
          <van-icon name="edit-o" size="40rpx" color="var(--primary-color)" />
        </view>
        <view class="section-title">十、备注说明</view>
        <view class="section-subtitle">其他约定事项</view>
      </view>

      <van-field
        type="textarea"
        placeholder="如有其他约定事项，请在此说明"
        value="{{formData.remark}}"
        data-field="remark"
        bind:change="onFieldChange"
        autosize
        border="{{false}}"
        custom-class="remark-field"
      />
    </view>

    <view class="bottom-space"></view>
  </scroll-view>

<!-- 底部按钮 -->
<view class="bottom-bar">
  <van-button type="default" size="small" round bind:click="onSaveDraft" class="bottom-bar-btn draft-btn">
    <van-icon name="draft" class="btn-icon" />
    保存草稿
  </van-button>
  <van-button type="default" size="small" round bind:click="onPreview" class="bottom-bar-btn preview-btn">
    <van-icon name="eye-o" class="btn-icon" />
    预览
  </van-button>
  <van-button type="default" size="small" round bind:click="onNextStep" class="bottom-bar-btn next-step-btn">
    <van-icon name="arrow-right" class="btn-icon" />
    {{currentStep < steps.length - 1 ? '下一步' : '创建合同'}}
  </van-button>
</view>

  <!-- 添加物品弹窗 -->
  <van-popup show="{{showAddItemPopup}}" position="bottom" bind:close="closeAddItemPopup" round>
    <view class="add-item-popup">
      <view class="add-item-popup-header">
        <text class="add-item-popup-title">添加物品</text>
        <view class="close-btn interactive" bindtap="closeAddItemPopup">
          <van-icon name="cross" size="32rpx" />
        </view>
      </view>
      <view class="add-item-form">
        <view class="select-from-list-btn">
          <van-button size="small" icon="list-switch" type="primary" plain bind:click="showInventoryPicker" block>
            从预定义列表选择
          </van-button>
        </view>
        <van-field
          label="物品名称"
          placeholder="请输入物品名称或从列表选择"
          value="{{newItemName}}"
          bind:change="onNewItemNameChange"
          size="large"
          required
          class="popup-field"
        />
        <view class="add-item-row">
          <van-field
            label="数量"
            placeholder="数量"
            value="{{newItemQuantity}}"
            bind:change="onNewItemQuantityChange"
            size="large"
            type="number"
            class="popup-field"
          />
          <van-field
            label="单位"
            placeholder="单位"
            value="{{newItemUnit}}"
            bind:change="onNewItemUnitChange"
            size="large"
            class="popup-field"
          />
        </view>
        <view class="add-item-actions">
          <van-button size="large" round bind:click="closeAddItemPopup" class="cancel-btn">取消</van-button>
          <van-button type="primary" size="large" round bind:click="confirmAddItem" class="confirm-btn">确定</van-button>
        </view>
      </view>
    </view>
  </van-popup>

  <!-- 物品选择器弹窗 -->
  <van-popup show="{{showInventoryPicker}}" position="bottom" bind:close="closeInventoryPicker" round>
    <view class="inventory-picker-popup">
      <view class="inventory-picker-header">
        <text class="inventory-picker-title">选择物品</text>
        <view class="close-btn interactive" bindtap="closeInventoryPicker">
          <van-icon name="cross" size="32rpx" />
        </view>
      </view>
      <scroll-view scroll-y class="inventory-picker-list">
        <view 
          wx:for="{{inventoryOptions}}" 
          wx:key="name" 
          class="inventory-picker-item interactive {{selectedInventoryIndex === index ? 'selected' : ''}}"
          data-index="{{index}}"
          bindtap="onInventoryPickerConfirm"
        >
          <view class="inventory-picker-item-info">
            <text class="inventory-picker-item-name">{{item.name}}</text>
            <text class="inventory-picker-item-unit">单位: {{item.unit}}</text>
          </view>
          <van-icon wx:if="{{selectedInventoryIndex === index}}" name="success" color="var(--primary-color)" size="32rpx" />
        </view>
      </scroll-view>
    </view>
  </van-popup>

  <!-- 日期选择弹窗 -->
  <van-popup show="{{showStartDatePicker}}" position="bottom" bind:close="closeStartDatePicker">
    <van-datetime-picker
      type="date"
      value="{{startDate}}"
      min-date="{{minDate}}"
      bind:confirm="onStartDateConfirm"
      bind:cancel="closeStartDatePicker"
      title="选择开始日期"
    />
  </van-popup>

  <van-popup show="{{showEndDatePicker}}" position="bottom" bind:close="closeEndDatePicker">
    <van-datetime-picker
      type="date"
      value="{{endDate}}"
      min-date="{{minDate}}"
      bind:confirm="onEndDateConfirm"
      bind:cancel="closeEndDatePicker"
      title="选择结束日期"
    />
  </van-popup>

  <!-- 第二次付款日期选择 -->
  <van-popup show="{{showSecondPaymentDatePicker}}" position="bottom" bind:close="closeSecondPaymentDatePicker">
    <van-datetime-picker
      type="date"
      value="{{secondPaymentDate}}"
      min-date="{{minDate}}"
      bind:confirm="onSecondPaymentDateConfirm"
      bind:cancel="closeSecondPaymentDatePicker"
      title="选择第二次付款日期"
    />
  </van-popup>

  <!-- 用途选择 -->
  <van-popup show="{{showPurposePicker}}" position="bottom" bind:close="closePurposePicker">
    <van-picker
      show-toolbar
      columns="{{purposeColumns}}"
      bind:confirm="onPurposeConfirm"
      bind:cancel="closePurposePicker"
      title="选择租赁用途"
    />
  </van-popup>

  <!-- 支付方式选择 -->
  <van-popup show="{{showPaymentMethodPicker}}" position="bottom" bind:close="closePaymentMethodPicker">
    <van-picker
      show-toolbar
      columns="{{paymentMethodColumns}}"
      bind:confirm="onPaymentMethodConfirm"
      bind:cancel="closePaymentMethodPicker"
      title="选择支付方式"
    />
  </van-popup>
</view>