/* pages/create-contract/index.wxss - Optimized */

.container {
  min-height: 100vh;
  background: var(--background-color);
  display: flex;
  flex-direction: column;
}

/* ========== Steps Wrapper ========== */
.steps-wrapper {
  padding: calc(var(--spacing-sm) * 0.5) 0; /* 减少垂直间距 */
  background: var(--card-background);
  border-bottom: 1rpx solid var(--border-color);
}

.steps-custom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  padding: 0 var(--spacing-lg);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto; /* 固定宽度而不是弹性 */
  position: relative;
  z-index: 1;
  min-width: 80rpx; /* 确保最小宽度 */
}

.step-connector {
  position: absolute;
  top: 50%; /* 垂直居中 */
  left: 0;
  right: 0;
  height: 2rpx; /* 细一些的连接线 */
  background: var(--border-color-light); /* 使用更淡的颜色 */
  z-index: 0;
  transform: translateY(-50%);
}

.step-dot-wrapper {
  position: relative;
  z-index: 2;
}

.step-dot {
  width: 44rpx; /* 稍微减小尺寸 */
  height: 44rpx;
  border-radius: 50%;
  background: var(--background-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-color-tertiary);
  transition: all var(--transition-fast) var(--ease-out);
  border: 2rpx solid var(--border-color);
}

.step-item.active .step-dot {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--text-color-inverse);
  transform: scale(1.05);
  box-shadow: 0 2rpx 6rpx rgba(30, 64, 175, 0.2);
}

.step-item.completed .step-dot {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--text-color-inverse);
}

.step-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
  margin-top: var(--spacing-xs);
  text-align: center;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: all var(--transition-fast) var(--ease-out);
  line-height: 1.2;
}

.step-item.active .step-label {
  color: var(--primary-color);
  font-weight: 600;
}

.step-item.completed .step-label {
  color: var(--text-color-secondary);
}

/* ========== Form Scroll ========== */
.form-scroll {
  flex: 1;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) * 3 + 96rpx);
  box-sizing: border-box;
}

/* ========== Section ========== */
.section {
  background: var(--card-background);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: all var(--transition-fast) var(--ease-out);
}

.section:not(.active) {
  opacity: 0.9;
  transform: scale(0.99);
}

.section.active {
  box-shadow: var(--shadow-md);
  border-color: var(--primary-color);
  transform: scale(1);
}

/* 增加章节之间的间距以提升层次感 */
.section + .section {
  margin-top: calc(var(--spacing-lg) * 1.5);
}

.section-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 2rpx solid var(--border-color);
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
  letter-spacing: -0.01em;
}

.section-subtitle {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  margin-left: auto;
}

/* ========== Form Field ========== */
.form-field {
  margin-bottom: var(--spacing-sm);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.form-field:last-child {
  margin-bottom: 0;
}

.disabled-field {
  opacity: 0.7;
}

.total-field {
  background: var(--primary-color-light) !important;
}

/* ========== Picker Cell ========== */
.picker-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-sm);
  border: 1rpx solid transparent;
  transition: all var(--transition-fast) var(--ease-out);
}

.picker-cell:active {
  background: var(--border-color);
}

.picker-cell.error {
  border-color: var(--danger-color);
}

.picker-label {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
}

.picker-label.required::after {
  content: ' *';
  color: var(--danger-color);
}

.picker-value-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.picker-value {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.picker-placeholder {
  font-size: var(--font-size-md);
  color: var(--text-color-placeholder);
}

.picker-arrow {
  color: var(--text-color-tertiary);
  transition: transform var(--transition-fast) var(--ease-out);
}

.picker-cell:active .picker-arrow {
  transform: translateX(4rpx);
}

/* ========== Tips ========== */
.info-tip,
.fee-tip,
.auto-tip,
.calc-tip,
.form-hint {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  background: var(--background-color-light);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  margin-top: var(--spacing-md);
}

.form-hint {
  color: var(--primary-color);
  background: var(--primary-color-light);
  font-weight: 500;
}

.tip-icon {
  color: var(--primary-color);
  flex-shrink: 0;
}

.auto-tip {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.calc-tip {
  color: var(--primary-color);
  background: var(--primary-color-light);
  font-weight: 500;
}

.section-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: var(--spacing-lg) 0 var(--spacing-md);
}

.divider-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  padding: 0 var(--spacing-md);
  position: relative;
}

.divider-text::before,
.divider-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 1rpx;
  background: var(--border-color);
}

.divider-text::before {
  right: 100%;
}

.divider-text::after {
  left: 100%;
}

/* ========== Payment Hint ========== */
.payment-hint {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: rgba(25, 137, 250, 0.08);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  font-size: var(--font-size-sm);
  color: var(--primary-color);
  line-height: 1.5;
}

.payment-hint .van-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* ========== Payment Item ========== */
.payment-item {
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color-light);
}

.payment-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.payment-item-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
}

.payment-item-tip {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

/* ========== Fee List ========== */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.fee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast) var(--ease-out);
}

.fee-item.interactive:active {
  background: var(--border-color);
}

.fee-item-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.fee-icon {
  font-size: 40rpx;
}

.fee-icon.water { color: #1989fa; }
.fee-icon.electric { color: #ff976a; }
.fee-icon.gas { color: #ee0a24; }
.fee-icon.tv { color: #07c160; }
.fee-icon.network { color: #7232dd; }
.fee-icon.property { color: #646c7b; }
.fee-icon.heating { color: #fe6b47; }

.fee-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.fee-note {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

.fee-note.owner {
  color: var(--primary-color);
}

/* ========== Inventory ========== */
.inventory-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.inventory-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast) var(--ease-out);
}

.inventory-item.interactive:active {
  background: var(--border-color);
}

.inventory-item-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
}

.inventory-icon {
  color: var(--primary-color);
  flex-shrink: 0;
}

.inventory-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.inventory-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.inventory-quantity {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.inventory-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.inventory-qty {
  width: 120rpx;
}

/* ========== Inventory Grid ========== */
.inventory-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.inventory-grid-item {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color-light);
}

.inventory-grid-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: var(--spacing-sm);
}

.inventory-grid-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.inventory-grid-unit {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.inventory-grid-input {
  display: flex;
  justify-content: flex-end;
}

/* ========== Inventory Summary ========== */
.inventory-summary {
  background: rgba(25, 137, 250, 0.05);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  border: 1rpx solid rgba(25, 137, 250, 0.15);
}

.inventory-summary-title {
  font-size: var(--font-size-md);
  color: var(--primary-color);
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
}

.inventory-summary-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.inventory-summary-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: 8rpx 16rpx;
  background: white;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
}

.summary-item-name {
  color: var(--text-color-primary);
}

.summary-item-qty {
  color: var(--primary-color);
  font-weight: 500;
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--danger-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger-color);
  transition: all var(--transition-fast) var(--ease-out);
}

.delete-btn.interactive:active {
  transform: scale(0.9);
  opacity: 0.8;
}

.add-item-btn {
  margin-top: var(--spacing-sm);
  border-style: dashed !important;
}

/* ========== Remark Field ========== */
.remark-field {
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  min-height: 200rpx;
}

/* ========== Bottom Bar ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-background);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: var(--spacing-md);
  z-index: 100;
}

.bottom-bar-btn {
  flex: 1;
  height: 96rpx; /* 稍微增加高度 */
  font-size: var(--font-size-md);
  font-weight: 600;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast) var(--ease-out);
  overflow: hidden;
  position: relative;
}

.btn-icon {
  margin-right: 0; /* 取消右边距，使用flex布局 */
  margin-bottom: 4rpx; /* 图标与文字之间的间距 */
  font-size: 28rpx; /* 稍微调整图标大小 */
}

.draft-btn {
  background: var(--background-color-light);
  border: 1rpx solid var(--border-color);
  color: var(--text-color-tertiary);
}

.draft-btn:active {
  background: var(--border-color-light);
}

.preview-btn {
  background: var(--card-background);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
}

.preview-btn:active {
  background: var(--primary-color-light);
}

/* 下一步按钮 */
.next-step-btn {
  background: var(--primary-color);
  color: var(--text-color-inverse);
  box-shadow: 0 2rpx 6rpx rgba(30, 64, 175, 0.2);
}

.next-step-btn:active {
  background: var(--primary-color-dark);
  transform: scale(0.98);
}

.submit-btn {
  background: var(--primary-color);
  color: var(--text-color-inverse);
  box-shadow: 0 2rpx 6rpx rgba(30, 64, 175, 0.2);
}

.submit-btn:active {
  background: var(--primary-color-dark);
  transform: scale(0.98);
}

/* 禁用状态 */
.bottom-bar-btn[disabled],
.bottom-bar-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 添加loading状态的样式（如果需要） */
.bottom-bar-btn.loading {
  opacity: 0.7;
  pointer-events: none;
}

/* ========== Add Item Popup ========== */
.add-item-popup {
  padding: var(--spacing-lg);
}

.add-item-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}

.add-item-popup-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--background-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-color-secondary);
}

.add-item-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.popup-field {
  border-radius: var(--radius-md);
  overflow: hidden;
}

.add-item-row {
  display: flex;
  gap: var(--spacing-md);
}

.add-item-row .popup-field {
  flex: 1;
}

.add-item-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.cancel-btn {
  flex: 1;
  background: var(--background-color-light) !important;
  border: 1rpx solid var(--border-color) !important;
  color: var(--text-color-primary) !important;
}

.confirm-btn {
  flex: 1;
}

/* ========== Bottom Space ========== */
.bottom-space {
  height: var(--spacing-xl);
}

/* ========== Select From List Button ========== */
.select-from-list-btn {
  margin-bottom: var(--spacing-md);
}

/* ========== Inventory Picker Popup ========== */
.inventory-picker-popup {
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.inventory-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-color);
}

.inventory-picker-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
}

.inventory-picker-list {
  flex: 1;
  max-height: 60vh;
}

.inventory-picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-color-light);
}

.inventory-picker-item.interactive:active {
  background: var(--background-color-light);
}

.inventory-picker-item.selected {
  background: rgba(25, 137, 250, 0.08);
}

.inventory-picker-item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.inventory-picker-item-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
}

.inventory-picker-item-unit {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
}