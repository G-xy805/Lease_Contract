/* pages/create-contract/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.form-scroll {
  height: calc(100vh - 120rpx);
  padding-bottom: 20rpx;
}

.section {
  background-color: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1989fa;
}

.sub-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #646566;
  margin: 24rpx 0 16rpx;
}

.info-card {
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #969799;
}

.info-value {
  font-size: 28rpx;
  color: #323233;
}

.info-value.company {
  color: #1989fa;
  font-weight: 500;
}

/* 日期单元格 */
.date-cell {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #ebedf0;
}

.date-label {
  flex: 1;
  font-size: 28rpx;
  color: #646566;
}

.date-label.required::after {
  content: ' *';
  color: #ee0a24;
}

.date-label.error::after {
  content: ' *';
  color: #ee0a24;
}

.date-value {
  font-size: 28rpx;
  color: #323233;
  margin-right: 8rpx;
}

.date-value.placeholder {
  color: #969799;
}

.date-arrow {
  color: #969799;
  font-size: 32rpx;
}

/* 押金说明 */
.deposit-note {
  font-size: 24rpx;
  color: #969799;
  padding: 16rpx 32rpx;
  background-color: #fff7e6;
  margin: 16rpx 0;
  border-radius: 8rpx;
}

/* 押金警告 */
.deposit-warning {
  font-size: 24rpx;
  color: #ee0a24;
  padding: 16rpx 32rpx;
  background-color: #fff0f0;
  margin: 16rpx 0;
  border-radius: 8rpx;
  border-left: 6rpx solid #ee0a24;
}

/* 续租提示 */
.notice-tip {
  font-size: 24rpx;
  color: #1989fa;
  padding: 16rpx 32rpx;
  background-color: #f0f7ff;
  margin: 16rpx 0;
  border-radius: 8rpx;
}

/* 费用提示 */
.fee-tip {
  font-size: 24rpx;
  color: #969799;
  padding: 16rpx 32rpx;
  margin-top: 16rpx;
}

/* 费用列表 */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ebedf0;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-note {
  font-size: 24rpx;
  color: #576b95;
}

.fee-note.owner {
  color: #07c160;
}

/* 物品表格 */
.items-note {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 16rpx;
}

.items-table {
  border: 1rpx solid #ebedf0;
  border-radius: 8rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background-color: #f7f8fa;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #646566;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #ebedf0;
  font-size: 26rpx;
}

.col-name {
  flex: 2;
  padding-left: 16rpx;
  color: #323233;
}

.col-qty {
  flex: 1;
  text-align: center;
}

.col-unit {
  flex: 1;
  text-align: center;
  color: #969799;
}

.col-check {
  width: 80rpx;
  text-align: center;
}

.table-row input {
  border: 1rpx solid #ebedf0;
  border-radius: 4rpx;
  padding: 8rpx;
  text-align: center;
  font-size: 24rpx;
  background-color: #fff;
}

/* 自定义物品 */
.custom-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: #f7f8fa;
  border-radius: 8rpx;
}

.custom-item-row .van-field {
  background-color: #fff;
  border-radius: 8rpx;
}

.item-input {
  flex: 2;
}

.item-qty {
  width: 120rpx;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #969799;
}

.delete-btn:active {
  color: #ee0a24;
}

.add-item-btn {
  margin-top: 16rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 16rpx 32rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  flex: 1;
}

.bottom-space {
  height: 160rpx;
}

/* 箭头图标 */
.arrow-icon {
  color: #969799;
  font-size: 32rpx;
}

/* 备注字段 */
.remark-field {
  background-color: #f7f8fa;
  border-radius: 8rpx;
  padding: 16rpx;
}

/* 错误状态 */
.van-field__error-message {
  font-size: 24rpx;
}
