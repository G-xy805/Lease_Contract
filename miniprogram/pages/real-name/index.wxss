.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
}

.steps-wrapper {
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.content {
  padding: 0 24rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #eee;
}

/* 身份证上传 */
.id-card-upload {
  padding: 24rpx 32rpx 32rpx;
}

.upload-item {
  margin-bottom: 24rpx;
}

.upload-item:last-child {
  margin-bottom: 0;
}

.upload-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.upload-box {
  width: 100%;
  height: 200rpx;
  background-color: #f8f8f8;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 人脸核身 */
.face-verification {
  padding: 24rpx 32rpx 32rpx;
}

.face-box {
  width: 100%;
  height: 240rpx;
  background-color: #f8f8f8;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.face-box.verified {
  border-color: #07c160;
  background-color: #f0f9f0;
}

.face-text {
  font-size: 26rpx;
  color: #666;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

.link {
  font-size: 24rpx;
  color: #1989fa;
}

/* 提交按钮 */
.submit-btn {
  padding: 32rpx;
}

/* 状态卡片通用 */
.status-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.status-icon {
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 32rpx;
}

/* 审核中 */
.status-card.pending .status-icon {
  display: flex;
  justify-content: center;
}

.status-info {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: left;
}

.info-item {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
}

/* 成功 */
.status-card.success .success-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.certified-info {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: left;
}

/* 失败 */
.status-card.failed .failed-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: #ee0a24;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.failed-reason {
  background-color: #fff5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: left;
  margin-top: 16rpx;
}

.reason-title {
  font-size: 26rpx;
  color: #ee0a24;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.reason-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 提示卡片 */
.tips-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-list text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.tips-list text::before {
  content: "• ";
}

/* 操作按钮 */
.action-btns {
  padding: 32rpx;
}
