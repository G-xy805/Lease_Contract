<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-content">
      <view class="header-icon-wrapper">
        <van-icon name="shield" size="48rpx" />
      </view>
      <view class="header-text-wrapper">
        <text class="page-title">实名认证</text>
        <text class="page-subtitle">为保障合同法律效力，请完成实名认证</text>
      </view>
    </view>
  </view>

  <!-- 认证状态卡片 -->
  <view class="auth-status-card card">
    <view class="status-icon-wrapper {{certificationStatus === 1 ? 'status-success' : certificationStatus === 2 ? 'status-pending' : 'status-default'}}">
      <van-icon name="{{certificationStatus === 1 ? 'checked' : certificationStatus === 2 ? 'clock-o' : 'idcard'}}" class="status-icon" />
    </view>
    <view class="status-info">
      <text class="status-title">{{certificationStatus === 1 ? '已认证' : certificationStatus === 2 ? '认证中' : '未认证'}}</text>
      <text class="status-desc">{{certificationStatus === 1 ? '您的身份信息已通过认证' : certificationStatus === 2 ? '认证审核中，请耐心等待' : '请填写并提交您的身份信息'}}</text>
    </view>
  </view>

  <!-- 已认证状态 -->
  <block wx:if="{{certificationStatus === 1}}">
    <view class="card user-info-card">
      <view class="info-header">
        <view class="header-icon-wrapper">
          <van-icon name="user-o" size="36rpx" />
        </view>
        <text class="header-title">认证信息</text>
      </view>
      <view class="info-list">
        <view class="info-row">
          <view class="info-label-wrapper">
            <van-icon name="manager-o" size="28rpx" class="row-icon" />
            <text class="info-label">姓名</text>
          </view>
          <text class="info-value">{{userInfo.realName}}</text>
        </view>
        <view class="info-row">
          <view class="info-label-wrapper">
            <van-icon name="idcard" size="28rpx" class="row-icon" />
            <text class="info-label">身份证号</text>
          </view>
          <text class="info-value idcard-value">{{idCardMasked}}</text>
        </view>
      </view>
      <view class="verified-badge">
        <van-icon name="passed" size="24rpx" />
        <text>身份信息已认证</text>
      </view>
    </view>
  </block>

  <!-- 未认证/认证中 -->
  <block wx:if="{{certificationStatus !== 1}}">
    <!-- 认证表单 -->
    <view class="card auth-form">
      <view class="form-header">
        <view class="header-icon-wrapper">
          <van-icon name="idcard" size="36rpx" />
        </view>
        <text class="header-title">身份信息</text>
      </view>

      <!-- 姓名 -->
      <view class="form-item">
        <view class="form-label-wrapper">
          <van-icon name="manager-o" size="28rpx" class="form-icon" />
          <text class="form-label">姓名 <text class="required">*</text></text>
        </view>
        <van-field
          value="{{realName}}"
          placeholder="请输入真实姓名"
          bind:change="onRealNameChange"
          disabled="{{certificationStatus === 2}}"
          custom-class="form-input"
        />
      </view>

      <!-- 身份证号 -->
      <view class="form-item">
        <view class="form-label-wrapper">
          <van-icon name="idcard" size="28rpx" class="form-icon" />
          <text class="form-label">身份证号 <text class="required">*</text></text>
        </view>
        <van-field
          value="{{idCard}}"
          placeholder="请输入18位身份证号"
          type="idcard"
          maxlength="18"
          bind:change="onIdCardChange"
          disabled="{{certificationStatus === 2}}"
          custom-class="form-input"
        />
      </view>
    </view>

    <!-- 身份证照片 -->
    <view class="card photo-upload">
      <view class="form-header">
        <view class="header-icon-wrapper">
          <van-icon name="photograph" size="36rpx" />
        </view>
        <text class="header-title">证件照片</text>
      </view>

      <view class="photo-grid">
        <!-- 身份证正面 -->
        <view class="photo-item">
          <view class="photo-label-wrapper">
            <van-icon name="idcard" size="24rpx" class="photo-icon" />
            <text class="photo-label">身份证正面</text>
          </view>
          <view class="photo-upload-area {{idCardFront ? 'has-image' : ''}}" bindtap="uploadIdCardFront">
            <image wx:if="{{idCardFront}}" src="{{idCardFront}}" mode="aspectFill" class="photo-preview" />
            <view wx:else class="photo-placeholder">
              <van-icon name="plus" size="56rpx" />
              <text class="placeholder-text">点击上传</text>
              <text class="placeholder-hint">人像面</text>
            </view>
          </view>
        </view>

        <!-- 身份证反面 -->
        <view class="photo-item">
          <view class="photo-label-wrapper">
            <van-icon name="idcard" size="24rpx" class="photo-icon" />
            <text class="photo-label">身份证反面</text>
          </view>
          <view class="photo-upload-area {{idCardBack ? 'has-image' : ''}}" bindtap="uploadIdCardBack">
            <image wx:if="{{idCardBack}}" src="{{idCardBack}}" mode="aspectFill" class="photo-preview" />
            <view wx:else class="photo-placeholder">
              <van-icon name="plus" size="56rpx" />
              <text class="placeholder-text">点击上传</text>
              <text class="placeholder-hint">国徽面</text>
            </view>
          </view>
        </view>
      </view>

      <view class="photo-tip">
        <van-icon name="info-o" size="28rpx" />
        <text>请确保照片清晰，信息可辨认</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <van-button
        type="primary"
        size="large"
        round
        block
        bind:click="submitCertification"
        loading="{{submitting}}"
        disabled="{{!canSubmit}}"
        class="submit-btn">
        <van-icon name="certificate" class="btn-icon" wx:if="{{certificationStatus !== 2}}" />
        {{certificationStatus === 2 ? '审核中...' : '提交认证'}}
      </van-button>
    </view>
  </block>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>