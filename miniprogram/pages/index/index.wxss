/* pages/index/index.wxss */

/* ========== 基础变量 ========== */
:root {
  --primary: #1989fa;
  --success: #07c160;
  --warning: #ff976a;
  --danger: #ee0a24;
  --gray: #969799;
  --gray-dark: #646566;
  --gray-light: #ebedf0;
  --bg-color: #f5f5f5;
  --card-bg: #ffffff;
  --border-radius: 16rpx;
  --spacing: 24rpx;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: var(--spacing);
  box-sizing: border-box;
}

/* ========== 卡片基础样式 ========== */
.card {
  background-color: var(--card-bg);
  border-radius: var(--border-radius);
  padding: var(--spacing);
  margin-bottom: var(--spacing);
  box-shadow: var(--shadow);
}

/* ========== 用户信息卡片 - 优化 ========== */
.user-card {
  background: linear-gradient(135deg, #1989fa 0%, #0066cc 100%);
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: var(--spacing);
}

.user-card-inner {
  display: flex;
  align-items: center;
}

.user-avatar-wrapper {
  position: relative;
}

.role-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #ffffff;
  white-space: nowrap;
}

.role-a {
  background-color: #07c160;
}

.role-b {
  background-color: #ff976a;
}

.user-detail {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #ffffff;
}

.user-role-name {
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 甲方统计卡片 - 3列网格布局 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: var(--spacing);
}

.stat-card {
  border-radius: var(--border-radius);
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  opacity: 0.1;
}

.stat-draft {
  background: linear-gradient(180deg, #1989fa 0%, #0066cc 100%);
}

.stat-pending {
  background: linear-gradient(180deg, #ff976a 0%, #ee0a24 100%);
}

.stat-signed {
  background: linear-gradient(180deg, #07c160 0%, #05903d 100%);
}

.stat-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.stat-number {
  color: #ffffff;
  line-height: 1.2;
}

.stat-label {
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

/* ========== 创建合同按钮 - 醒目设计 ========== */
.create-btn-wrapper {
  margin-bottom: var(--spacing);
  padding: 0;
  overflow: hidden;
}

.create-btn-inner {
  background: linear-gradient(135deg, #07c160 0%, #05903d 100%);
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.create-btn-left {
  display: flex;
  align-items: center;
}

.create-btn-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 16rpx;
}

/* ========== 合同列表区块 ========== */
.contract-section {
  padding: var(--spacing);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.view-all {
  display: flex;
  align-items: center;
}

.contract-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 合同卡片 ========== */
.contract-card {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid var(--gray-light);
  transition: all 0.2s ease;
}

.contract-card:active {
  background-color: #f0f0f0;
  transform: scale(0.98);
}

.contract-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.contract-title {
  flex: 1;
  margin-right: 16rpx;
  word-break: break-all;
}

.contract-card-body {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.contract-info-item {
  display: flex;
  align-items: center;
}

.contract-info-text {
  margin-left: 8rpx;
}

.contract-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gray-light);
}

.contract-action-hint {
  display: flex;
  align-items: center;
}

/* ========== 乙方邀请入口卡片 ========== */
.invite-action-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: var(--spacing);
}

.invite-action-card {
  background-color: var(--card-bg);
  border-radius: var(--border-radius);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow);
  position: relative;
}

.invite-action-card:active {
  transform: scale(0.98);
}

.invite-action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #f0f9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.scan-icon {
  background-color: #f0fff4;
}

.invite-action-content {
  text-align: center;
  margin-bottom: 8rpx;
}

.invite-action-title {
  font-size: 28rpx;
  color: #323233;
  margin-bottom: 8rpx;
}

.invite-action-desc {
  font-size: 22rpx;
}

/* ========== 乙方签署邀请入口 ========== */
.invitation-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing);
}

.invitation-left {
  display: flex;
  align-items: center;
}

.invitation-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #f0f9ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invitation-right {
  display: flex;
  align-items: center;
}

/* ========== 未登录提示 ========== */
.login-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 300rpx;
}

/* ========== 加载状态 ========== */
.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

/* ========== 文字样式工具类 ========== */
.text-lg {
  font-size: 32rpx;
}

.text-md {
  font-size: 28rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 20rpx;
}

.text-xl {
  font-size: 40rpx;
}

.text-bold {
  font-weight: bold;
}

.text-primary {
  color: var(--primary);
}

.text-warning {
  color: var(--warning);
}

.text-success {
  color: var(--success);
}

.text-danger {
  color: var(--danger);
}

.text-gray {
  color: var(--gray);
}

.text-center {
  text-align: center;
}

.mt-xs {
  margin-top: 8rpx;
}

.mb-md {
  margin-bottom: 16rpx;
}

.ml-md {
  margin-left: 16rpx;
}

.mb-sm {
  margin-bottom: 12rpx;
}

.mb-lg {
  margin-bottom: 24rpx;
}
