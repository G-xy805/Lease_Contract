/* pages/index/index.wxss - Dashboard样式（使用CSS变量） */

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: var(--bg-page, #f5f7fa);
  padding: var(--spacing-md, 24rpx);
  box-sizing: border-box;
}

/* ========== 头部用户信息栏 ========== */
.header {
  background: var(--card-background, #ffffff);
  border-radius: var(--radius-xl, 24rpx);
  padding: var(--spacing-lg, 32rpx);
  margin-bottom: var(--spacing-lg, 32rpx);
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.06));
}

.user-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-md, 24rpx);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--bg-page, #f5f7fa);
  flex-shrink: 0;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs, 12rpx);
  flex: 1;
}

.user-name {
  font-size: var(--font-size-xl, 36rpx);
  font-weight: 700;
  color: var(--text-primary, #1a1a1a);
}

.user-tags {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm, 16rpx);
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: var(--font-size-xs, 22rpx);
  font-weight: 500;
}

.tag-role {
  background: var(--primary-light, #e8f0fe);
  color: var(--primary-color, #1976d2);
}

.tag-success {
  background: var(--success-light, #e8f5e9);
  color: var(--success-color, #4caf50);
}

.tag-warning {
  background: var(--warning-light, #fff3e0);
  color: var(--warning-color, #ff9800);
}

/* ========== 统计面板 ========== */
.stats-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg, 32rpx) var(--spacing-xl, 40rpx);
  margin-bottom: var(--spacing-lg, 32rpx);
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.06));
}

.card {
  background: var(--card-background, #ffffff);
  border-radius: var(--radius-xl, 24rpx);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs, 12rpx);
}

.stats-number {
  font-size: var(--font-size-2xl, 48rpx);
  font-weight: 700;
  line-height: 1.2;
}

.text-primary {
  color: var(--primary-color, #1976d2);
}

.text-warning {
  color: var(--warning-color, #ff9800);
}

.text-success {
  color: var(--success-color, #4caf50);
}

.text-secondary {
  color: var(--text-secondary, #666666);
}

.text-sm {
  font-size: var(--font-size-sm, 26rpx);
}

.stats-label {
  font-size: var(--font-size-sm, 26rpx);
  color: var(--text-tertiary, #999999);
  font-weight: 500;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-color, #e0e0e0);
  margin: 0 var(--spacing-lg, 32rpx);
}

/* ========== 快捷操作 ========== */
.quick-actions {
  display: flex;
  gap: var(--spacing-md, 24rpx);
  margin-bottom: var(--spacing-lg, 32rpx);
}

.action-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg, 16rpx);
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
  transition: all var(--transition-fast, 0.15s) ease-out;
}

.action-btn.primary {
  background: var(--primary-color, #1976d2);
  color: #ffffff;
  box-shadow: var(--shadow-md, 0 4rpx 12rpx rgba(25, 118, 210, 0.25));
}

.action-btn.primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-btn.secondary {
  background: var(--card-background, #ffffff);
  color: var(--text-secondary, #666666);
  border: 2rpx solid var(--border-color, #e0e0e0);
}

.action-btn.secondary:active {
  background: var(--bg-page, #f5f7fa);
  transform: scale(0.98);
}

/* ========== 标题栏 ========== */
.section-title-bar {
  padding: var(--spacing-sm, 16rpx) 0;
  margin-bottom: var(--spacing-md, 24rpx);
}

.section-title-bar text {
  font-size: var(--font-size-lg, 34rpx);
  font-weight: 600;
  color: var(--text-primary, #1a1a1a);
}

/* ========== 合同列表 ========== */
.contract-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 24rpx);
  margin-bottom: var(--spacing-lg, 32rpx);
}

/* ========== 加载更多提示 ========== */
.load-more {
  text-align: center;
  padding: var(--spacing-lg, 32rpx) 0;
  color: var(--text-tertiary, #999999);
  font-size: var(--font-size-sm, 26rpx);
}

/* ========== 骨架屏 ========== */
.skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 24rpx);
}

.skeleton-card {
  background: var(--card-background, #ffffff);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--spacing-lg, 32rpx);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm, 16rpx);
}

.skeleton-line {
  height: 32rpx;
  background: linear-gradient(
    90deg,
    var(--bg-page, #f5f7fa) 25%,
    var(--border-color-light, #f0f0f0) 50%,
    var(--bg-page, #f5f7fa) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm, 8rpx);
}

.skeleton-line.long {
  width: 80%;
}

.skeleton-line.medium {
  width: 60%;
}

.skeleton-line.short {
  width: 40%;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
