/* pages/index/index.wxss - Optimized */

/* ========== Container ========== */
.container {
  min-height: 100vh;
  background: var(--background-color);
  box-sizing: border-box;
  padding: var(--spacing-md);
}

/* ========== Welcome Section ========== */
.welcome-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-lg);
  animation: fadeIn var(--transition-normal) var(--ease-out);
}

.welcome-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.avatar-wrapper {
  position: relative;
  width: 112rpx;
  height: 112rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--background-color-light);
  border: 4rpx solid var(--card-background);
  box-shadow: var(--shadow-md);
}

.avatar-ring {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary-color-light);
  opacity: 0.6;
}

.welcome-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.welcome-name {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--text-color-primary);
  letter-spacing: -0.01em;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 500;
  width: fit-content;
}

.role-lessor {
  background: var(--primary-color-light);
  color: var(--primary-color);
}

.role-tenant {
  background: var(--secondary-color-light);
  color: var(--secondary-color);
}

.role-admin {
  background: var(--warning-color-light);
  color: var(--warning-color-dark);
}

.role-icon {
  font-size: 22rpx;
}

.notification-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-background);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast) var(--ease-out);
  cursor: pointer;
}

.notification-btn:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-xs);
}

.notification-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--danger-color);
  border-radius: 50%;
  border: 3rpx solid var(--card-background);
}

/* ========== Stats Section ========== */
.stats-section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp var(--transition-normal) var(--ease-out);
  animation-delay: 50ms;
  animation-fill-mode: backwards;
}

.stats-header {
  margin-bottom: var(--spacing-md);
}

.stats-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  letter-spacing: -0.01em;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
}

.stat-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--spacing-md);
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
  transition: all var(--transition-fast) var(--ease-out);
}

.stat-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-xs);
}

.stat-icon-bg {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.stat-card-primary .stat-icon-bg {
  background: var(--primary-color-light);
}

.stat-card-warning .stat-icon-bg {
  background: var(--warning-color-light);
}

.stat-card-success .stat-icon-bg {
  background: var(--success-color-light);
}

.stat-icon {
  font-size: 40rpx;
}

.stat-card-primary .stat-icon {
  color: var(--primary-color);
}

.stat-card-warning .stat-icon {
  color: var(--warning-color);
}

.stat-card-success .stat-icon {
  color: var(--success-color);
}

.stat-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-num {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--text-color-primary);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.stat-label {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-weight: 500;
}

.stat-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 0 0 0 120rpx;
  opacity: 0.1;
}

.stat-card-primary .stat-decoration {
  background: var(--primary-color);
}

.stat-card-warning .stat-decoration {
  background: var(--warning-color);
}

.stat-card-success .stat-decoration {
  background: var(--success-color);
}

/* ========== Action Section ========== */
.action-section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp var(--transition-normal) var(--ease-out);
  animation-delay: 100ms;
  animation-fill-mode: backwards;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.action-btn-primary {
  height: 112rpx;
  font-size: var(--font-size-lg);
  font-weight: 600;
  border-radius: var(--radius-xl) !important;
  box-shadow: var(--shadow-md);
  transition: all var(--transition-fast) var(--ease-out);
}

.action-btn-primary .btn-icon {
  margin-right: var(--spacing-xs);
  font-size: 40rpx;
}

.action-btn-primary:not(.van-button--disabled):active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.action-btn-secondary {
  height: 112rpx;
  font-size: var(--font-size-lg);
  font-weight: 500;
  border-radius: var(--radius-xl) !important;
  background: var(--card-background) !important;
  border: 2rpx solid var(--border-color) !important;
  transition: all var(--transition-fast) var(--ease-out);
}

.action-btn-secondary .btn-icon {
  margin-right: var(--spacing-xs);
  font-size: 40rpx;
}

.action-btn-secondary:active {
  background: var(--background-color-light) !important;
  transform: scale(0.98);
}

.btn-text {
  letter-spacing: 0.02em;
}

.btn-text-secondary {
  color: var(--text-color-secondary);
}

/* ========== Section ========== */
.section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp var(--transition-normal) var(--ease-out);
  animation-delay: 150ms;
  animation-fill-mode: backwards;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  letter-spacing: -0.01em;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--text-color-tertiary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-full);
  transition: all var(--transition-fast) var(--ease-out);
}

.section-more:active {
  background: var(--background-color-light);
}

/* ========== Contract List ========== */
.contract-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.contract-card {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--card-background);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: all var(--transition-fast) var(--ease-out);
  cursor: pointer;
}

.contract-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-xs);
  border-color: var(--border-color-dark);
}

.contract-status-bar {
  width: 8rpx;
  height: 96rpx;
  border-radius: 4rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.status-color-0 {
  background: var(--text-color-secondary);
}

.status-color-1, .status-color-2 {
  background: var(--warning-color);
}

.status-color-3 {
  background: var(--success-color);
}

.status-color-4 {
  background: var(--danger-color);
}

.status-color-5, .status-color-6 {
  background: var(--text-color-tertiary);
}

.contract-content {
  flex: 1;
  min-width: 0;
}

.contract-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-xs);
  gap: var(--spacing-sm);
}

.contract-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  flex: 1;
  margin-right: var(--spacing-sm);
}

.contract-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon {
  color: var(--text-color-tertiary);
}

.contract-date {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

.contract-arrow {
  margin-left: var(--spacing-sm);
  flex-shrink: 0;
  transition: transform var(--transition-fast) var(--ease-out);
}

.contract-card:active .contract-arrow {
  transform: translateX(4rpx);
}

/* ========== Pending Notice ========== */
.pending-notice {
  margin-bottom: var(--spacing-md);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all var(--transition-fast) var(--ease-out);
  cursor: pointer;
}

.pending-notice:active {
  transform: scale(0.99);
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl) var(--spacing-xl);
  background: var(--card-background);
  border-radius: var(--radius-xl);
  border: 1rpx dashed var(--border-color);
}

.empty-illustration {
  margin-bottom: var(--spacing-md);
}

.create-btn {
  margin-top: var(--spacing-md);
  height: 72rpx;
  padding: 0 var(--spacing-xl);
}

.create-btn .btn-icon {
  margin-right: 6rpx;
  font-size: 32rpx;
}

/* ========== Loading ========== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  z-index: 100;
}

/* ========== Animations ========== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}