<!-- pages/index/index.wxml -->
<view class="page-container">
  <!-- 顶部用户信息栏 -->
  <view class="header">
    <view class="user-info">
      <image
        class="avatar"
        src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="user-detail">
        <text class="user-name">{{userInfo.name || userInfo.phone || '用户'}}</text>
        <view class="user-tags">
          <text class="tag tag-role">
            {{userRole === 'LESSOR' ? '房东' : userRole === 'LESSEE' ? '租客' : userRole === 'ADMIN' ? '管理员' : '未知'}}
          </text>
          <text class="tag {{isRealNameVerified ? 'tag-success' : 'tag-warning'}}">
            {{isRealNameVerified ? '已实名' : '未实名'}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计面板 -->
  <view class="stats-panel card" wx:if="{{userInfo}}">
    <view class="stats-item" bindtap="onViewAll">
      <text class="stats-number text-primary">{{stats.totalContracts}}</text>
      <text class="stats-label">全部合同</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-number text-warning">{{stats.pendingSignCount}}</text>
      <text class="stats-label">待签署</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-number text-success">{{stats.completedCount}}</text>
      <text class="stats-label">已完成</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions" wx:if="{{userInfo}}">
    <view class="action-btn primary" bindtap="onCreateContract">
      <text>＋ 创建合同</text>
    </view>
    <view class="action-btn secondary" bindtap="onViewAll">
      <text>查看全部</text>
    </view>
  </view>

  <!-- 最近合同标题 -->
  <view class="section-title-bar" wx:if="{{userInfo}}">
    <text>最近合同</text>
  </view>

  <!-- 合同列表 - 使用 contract-card 组件 -->
  <view class="contract-list" wx:if="{{recentContracts.length > 0 && !loading}}">
    <block wx:for="{{recentContracts}}" wx:key="id">
      <contract-card
        id="{{item.id}}"
        title="{{item.title}}"
        address="{{item.address}}"
        status="{{item.status}}"
        monthlyRent="{{item.monthlyRent}}"
        partyA="{{item.partyA}}"
        partyB="{{item.partyB}}"
        createdAt="{{item.createdAt}}"
        leaseStart="{{item.leaseStart}}"
        leaseEnd="{{item.leaseEnd}}"
        bind:tap="onContractTap"
      />
    </block>
  </view>

  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{!loading && recentContracts.length > 0}}">
    <text wx:if="{{hasMore}}" class="text-secondary text-sm">上拉加载更多</text>
    <text wx:else class="text-secondary text-sm">— 没有更多了 —</text>
  </view>

  <!-- 空状态 - 使用 empty-state 组件 -->
  <empty-state
    wx:if="{{!loading && userInfo && recentContracts.length === 0}}"
    type="no-data"
    actionText="创建第一个合同"
    bind:action="onCreateContract"
  />

  <!-- 骨架屏 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{3}}" wx:key="*this">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
      <view class="skeleton-line short"></view>
    </view>
  </view>
</view>
