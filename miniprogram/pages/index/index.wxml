<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 欢迎区域 -->
  <view class="welcome-section">
    <view class="welcome-left">
      <view class="avatar-wrapper">
        <image class="avatar" src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="avatar-ring"></view>
      </view>
      <view class="welcome-info">
        <text class="welcome-name">{{userInfo.name || '用户'}}</text>
        <view class="role-badge role-{{userInfo.role === 'LESSOR' ? 'lessor' : userInfo.role === 'ADMIN' ? 'admin' : 'tenant'}}">
          <van-icon name="{{userInfo.role === 'LESSOR' ? 'home-o' : userInfo.role === 'ADMIN' ? 'setting-o' : 'user-o'}}" class="role-icon" />
          {{userInfo.role === 'LESSOR' ? '出租方' : userInfo.role === 'ADMIN' ? '管理员' : '承租方'}}
        </view>
      </view>
    </view>
    <view class="notification-btn touch-target" bindtap="goToNotifications">
      <van-icon name="bell" size="44rpx" color="var(--text-color-secondary)" />
      <view class="notification-dot" wx:if="{{unreadCount > 0}}"></view>
    </view>
  </view>

  <!-- 甲方视图 -->
  <block wx:if="{{userInfo && (userInfo.role === 'LESSOR' || userInfo.role === 'ADMIN')}}">
    <!-- 统计卡片区域 -->
    <view class="stats-section">
      <view class="stats-header">
        <text class="stats-title">合同概览</text>
      </view>
      <view class="stats-grid">
        <view class="stat-card stat-card-primary interactive" bindtap="goToContracts" data-filter="all">
          <view class="stat-icon-bg">
            <van-icon name="orders-o" class="stat-icon" />
          </view>
          <view class="stat-content">
            <text class="stat-num">{{stats.totalCount}}</text>
            <text class="stat-label">合同总数</text>
          </view>
          <view class="stat-decoration"></view>
        </view>

        <view class="stat-card stat-card-warning interactive" bindtap="goToContracts" data-filter="pending">
          <view class="stat-icon-bg">
            <van-icon name="clock-o" class="stat-icon" />
          </view>
          <view class="stat-content">
            <text class="stat-num">{{stats.pendingSignCount}}</text>
            <text class="stat-label">待签署</text>
          </view>
          <view class="stat-decoration"></view>
        </view>

        <view class="stat-card stat-card-success interactive" bindtap="goToContracts" data-filter="signed">
          <view class="stat-icon-bg">
            <van-icon name="passed" class="stat-icon" />
          </view>
          <view class="stat-content">
            <text class="stat-num">{{stats.signedCount}}</text>
            <text class="stat-label">已签署</text>
          </view>
          <view class="stat-decoration"></view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="action-section">
      <view class="section-header">
        <text class="section-title">快捷操作</text>
      </view>
      <view class="action-buttons">
        <van-button type="primary" size="large" round block bind:click="goToCreateContract" class="action-btn-primary">
          <van-icon name="plus" class="btn-icon" />
          <text class="btn-text">创建合同</text>
        </van-button>
        <van-button type="default" size="large" round block bind:click="goToContracts" class="action-btn-secondary">
          <van-icon name="list" class="btn-icon" />
          <text class="btn-text-secondary">查看合同列表</text>
        </van-button>
      </view>
    </view>

    <!-- 最近合同 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近操作</text>
        <view class="section-more interactive" bindtap="goToContracts">
          <text>查看更多</text>
          <van-icon name="arrow-right" size="24rpx" />
        </view>
      </view>

      <view wx:if="{{recentContracts.length > 0}}" class="contract-list">
        <view
          wx:for="{{recentContracts}}"
          wx:key="id"
          class="contract-card interactive"
          bindtap="goToContractDetail"
          data-id="{{item.id}}"
        >
          <view class="contract-status-bar status-color-{{item.status}}"></view>
          <view class="contract-content">
            <view class="contract-header">
              <text class="contract-title text-ellipsis">{{item.title}}</text>
              <van-tag type="{{item.status === 3 ? 'success' : item.status === 2 ? 'warning' : item.status === 4 ? 'danger' : 'default'}}" size="small">
                {{item.statusText}}
              </van-tag>
            </view>
            <view class="contract-meta">
              <van-icon name="clock-o" size="24rpx" class="meta-icon" />
              <text class="contract-date">{{item.updateTime}}</text>
            </view>
          </view>
          <van-icon name="arrow" class="contract-arrow" size="32rpx" color="var(--text-color-tertiary)" />
        </view>
      </view>

      <view wx:else class="empty-state">
        <view class="empty-illustration">
          <van-empty description="暂无合同" image="default" />
        </view>
        <van-button type="primary" round size="small" bind:click="goToCreateContract" class="create-btn">
          <van-icon name="plus" class="btn-icon" />
          立即创建
        </van-button>
      </view>
    </view>
  </block>

  <!-- 乙方视图 -->
  <block wx:if="{{userInfo && userInfo.role === 'LESSEE'}}">
    <!-- 待签署提醒 -->
    <view wx:if="{{pendingSignCount > 0}}" class="pending-notice interactive" bindtap="goToMyContracts">
      <van-notice-bar text="您有 {{pendingSignCount}} 份合同待签署" left-icon="warning-o" color="var(--warning-color-dark)" background="var(--warning-color-light)" />
    </view>

    <!-- 快捷操作 -->
    <view class="action-section">
      <view class="section-header">
        <text class="section-title">我的合同</text>
      </view>
      <van-button type="primary" size="large" round block bind:click="goToMyContracts" class="action-btn-primary">
        <van-icon name="orders-o" class="btn-icon" />
        <text class="btn-text">查看我的合同</text>
      </van-button>
    </view>

    <!-- 最近合同 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近操作</text>
      </view>

      <view wx:if="{{recentContracts.length > 0}}" class="contract-list">
        <view
          wx:for="{{recentContracts}}"
          wx:key="id"
          class="contract-card interactive"
          bindtap="goToContractDetail"
          data-id="{{item.id}}"
        >
          <view class="contract-status-bar status-color-{{item.status}}"></view>
          <view class="contract-content">
            <view class="contract-header">
              <text class="contract-title text-ellipsis">{{item.title}}</text>
              <van-tag type="{{item.status === 3 ? 'success' : item.status === 2 ? 'warning' : item.status === 4 ? 'danger' : 'default'}}" size="small">
                {{item.statusText}}
              </van-tag>
            </view>
            <view class="contract-meta">
              <van-icon name="clock-o" size="24rpx" class="meta-icon" />
              <text class="contract-date">{{item.updateTime}}</text>
            </view>
          </view>
          <van-icon name="arrow" class="contract-arrow" size="32rpx" color="var(--text-color-tertiary)" />
        </view>
      </view>

      <view wx:else class="empty-state">
        <van-empty description="暂无合同" image="default" />
      </view>
    </view>
  </block>

  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <van-loading type="spinner" size="60rpx" color="var(--primary-color)">加载中...</van-loading>
  </view>
</view>