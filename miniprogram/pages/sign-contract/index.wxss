.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 合同信息卡片 */
.contract-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.contract-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.contract-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.contract-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.contract-status.pending_sign {
  background: #fff7e6;
  color: #fa8c16;
}

.contract-status.signed {
  background: #e6f7ff;
  color: #1890ff;
}

.contract-status.completed {
  background: #f6ffed;
  color: #52c41a;
}

.contract-status.expired {
  background: #fff1f0;
  color: #ff4d4f;
}

.contract-status.cancelled {
  background: #f5f5f5;
  color: #999;
}

.info-detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
}

/* 签署区 */
.sign-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

/* 签名工具栏 */
.sign-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.tool-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tool-label {
  font-size: 26rpx;
  color: #666;
}

/* 颜色选择 */
.color-options {
  display: flex;
  gap: 16rpx;
}

.color-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.color-btn.active {
  border-color: #1890ff;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.2);
}

.color-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.color-dot.black {
  background: #000;
}

.color-dot.blue {
  background: #1A73E8;
}

/* 粗细选择 */
.thickness-options {
  display: flex;
  gap: 16rpx;
}

.thickness-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.thickness-btn.active {
  border-color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
}

.thickness-line {
  width: 32rpx;
  background: #333;
  border-radius: 4rpx;
}

.thickness-line.thin {
  height: 2rpx;
}

.thickness-line.medium {
  height: 4rpx;
}

.thickness-line.thick {
  height: 6rpx;
}

/* 签名画布 */
.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.sign-canvas {
  width: 100%;
  height: 100%;
}

.canvas-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  pointer-events: none;
}

.canvas-placeholder text {
  font-size: 28rpx;
  color: #ccc;
}

/* 右下角清除按钮 */
.clear-btn-wrapper {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 10;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  color: #fff;
  font-size: 24rpx;
}

.clear-btn:active {
  background: rgba(0, 0, 0, 0.7);
}

/* 签署提示 */
.sign-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #999;
  font-size: 24rpx;
}

/* 提交区域 */
.submit-section {
  padding: 0 32rpx;
}

/* 结果弹窗 */
.result-popup {
  width: 560rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon.success {
  background: #f6ffed;
  color: #52c41a;
}

.result-icon.error {
  background: #fff2f0;
  color: #ff4d4f;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.result-message {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.result-buttons {
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.result-buttons van-button {
  flex: 1;
}