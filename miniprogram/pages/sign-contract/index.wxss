/* pages/sign-contract/index.wxss - Optimized */

.container {
  min-height: 100vh;
  background: var(--background-color);
  padding: var(--spacing-md);
  box-sizing: border-box;
  padding-bottom: 180rpx;
}

/* ========== Contract Info ========== */
.contract-info {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 2rpx solid var(--border-color);
}

.contract-title-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex: 1;
}

.contract-icon {
  color: var(--primary-color);
  flex-shrink: 0;
}

.contract-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
}

.contract-status {
  font-size: var(--font-size-xs);
  padding: 6rpx var(--spacing-md);
  border-radius: var(--radius-full);
  font-weight: 600;
  flex-shrink: 0;
}

.contract-status.pending,
.contract-status.pending_sign {
  background: var(--warning-color-light);
  color: var(--warning-color);
}

.contract-status.signed {
  background: var(--primary-color-light);
  color: var(--primary-color);
}

.contract-status.completed {
  background: var(--success-color-light);
  color: var(--success-color);
}

.contract-status.expired {
  background: var(--danger-color-light);
  color: var(--danger-color);
}

.contract-status.cancelled {
  background: var(--background-color-light);
  color: var(--text-color-tertiary);
}

.contract-status.draft {
  background: var(--background-color-light);
  color: var(--text-color-secondary);
}

.info-detail {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-xs) 0;
}

.info-row.highlight-row {
  background: var(--primary-color-light);
  margin: var(--spacing-xs) calc(-1 * var(--spacing-md));
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
}

.info-label-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.row-icon {
  color: var(--text-color-tertiary);
  flex-shrink: 0;
}

.row-icon.highlight-icon {
  color: var(--primary-color);
}

.label {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

.value {
  font-size: var(--font-size-sm);
  color: var(--text-color-primary);
  text-align: right;
  max-width: 380rpx;
}

.value.address-value {
  font-size: var(--font-size-xs);
  max-width: 320rpx;
}

.value.highlight {
  color: var(--danger-color);
  font-weight: 700;
  font-size: var(--font-size-md);
}

/* ========== Role Hint ========== */
.role-hint {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--primary-color-light);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  border: 1rpx solid var(--primary-color-light);
}

.role-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--card-background);
  flex-shrink: 0;
}

.role-hint text {
  font-size: var(--font-size-sm);
  color: var(--text-color-primary);
}

.role-hint b {
  font-weight: 700;
  color: var(--primary-color);
}

/* ========== Sign Section ========== */
.sign-section {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.section-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.section-icon {
  color: var(--primary-color);
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

/* ========== Sign Toolbar ========== */
.sign-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-lg);
}

.tool-group {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.tool-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  font-weight: 500;
}

.color-options {
  display: flex;
  gap: var(--spacing-md);
}

.color-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast) var(--ease-out);
  background: var(--card-background);
}

.color-btn.active {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 6rpx rgba(25, 137, 250, 0.2);
}

.color-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.color-dot.black {
  background: #000000;
}

.color-dot.blue {
  background: #1A73E8;
}

.thickness-options {
  display: flex;
  gap: var(--spacing-sm);
}

.thickness-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast) var(--ease-out);
  background: var(--card-background);
}

.thickness-btn.active {
  border-color: var(--primary-color);
  background: var(--primary-color-light);
}

.thickness-line {
  width: 32rpx;
  background: #333;
  border-radius: 4rpx;
}

.thickness-line.thin {
  height: 2rpx;
}

.thickness-line.medium {
  height: 4rpx;
}

.thickness-line.thick {
  height: 6rpx;
}

/* ========== Canvas ========== */
.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  border: 3rpx dashed var(--primary-color-light);
  border-radius: var(--radius-xl);
  background: var(--card-background);
  overflow: hidden;
}

.sign-canvas {
  width: 100%;
  height: 100%;
}

.canvas-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  pointer-events: none;
}

.placeholder-icon {
  color: var(--text-color-placeholder);
}

.canvas-placeholder text {
  font-size: var(--font-size-md);
  color: var(--text-color-placeholder);
}

.clear-btn-wrapper {
  position: absolute;
  right: var(--spacing-md);
  bottom: var(--spacing-md);
  z-index: 10;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--spacing-xs) var(--spacing-md);
  background: rgba(0, 0, 0, 0.6);
  border-radius: var(--radius-full);
  color: var(--card-background);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.clear-btn:active {
  background: rgba(0, 0, 0, 0.8);
}

.sign-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--success-color-light);
  border-radius: var(--radius-md);
  color: var(--success-color);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

/* ========== Submit Section ========== */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-background);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.submit-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  box-shadow: var(--shadow-md);
}

.submit-btn .btn-icon {
  margin-right: var(--spacing-sm);
  font-size: 36rpx;
}

/* ========== Confirm Dialog ========== */
.confirm-footer {
  padding: var(--spacing-md) var(--spacing-lg);
}

.confirm-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.confirm-label-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.confirm-icon {
  color: var(--text-color-tertiary);
}

.confirm-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

.confirm-value {
  font-size: var(--font-size-sm);
  color: var(--text-color-primary);
  font-weight: 600;
}

/* ========== Result Popup ========== */
.result-popup {
  width: 560rpx;
  padding: var(--spacing-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.result-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon-wrapper.success {
  background: var(--success-color-light);
  color: var(--success-color);
}

.result-icon-wrapper.error {
  background: var(--danger-color-light);
  color: var(--danger-color);
}

.result-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
  text-align: center;
}

.result-message {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  text-align: center;
  line-height: 1.6;
}

.result-buttons {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

.result-btn {
  flex: 1;
}

.result-btn.primary {
  box-shadow: var(--shadow-sm);
}