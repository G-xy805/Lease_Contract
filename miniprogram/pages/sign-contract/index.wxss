/* pages/sign-contract/index.wxss - v2 (signRole参数体系) */

.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding: var(--spacing-md);
  box-sizing: border-box;
  padding-bottom: 180rpx;
}

/* ========== Error Banner (⭐ 新增 - 前置检查失败提示) ========== */
.error-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg);
  gap: var(--spacing-md);
}

.error-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--danger-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.error-text {
  font-size: var(--font-size-md);
  color: var(--danger-color);
  text-align: center;
  line-height: 1.6;
}

.btn-return {
  margin-top: var(--spacing-md);
  width: 400rpx;
  height: 88rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-xl);
  border: none;
}

/* ========== Loading Spinner ========== */
.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: var(--spacing-lg);
}

.loading-text {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
}

/* ========== Page Header (⭐ 新增 - 根据signRole动态显示) ========== */
.page-header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, var(--primary-color-light) 0%, var(--card-background) 100%);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.page-title {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: var(--spacing-xs);
}

.page-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  font-family: monospace;
}

/* ========== Contract Summary (合同摘要卡片) ========== */
.card {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.contract-summary {
  background: linear-gradient(135deg, var(--background-color-light) 0%, var(--card-background) 100%);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  font-weight: 500;
}

.summary-value {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.summary-value.price {
  color: var(--danger-color);
  font-weight: 700;
  font-size: var(--font-size-lg);
}

/* ========== Signature Area (签名区域) ========== */
.signature-area {
  background: var(--card-background);
}

.section-title-bar {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

/* ========== Sign Toolbar (签名工具栏) ========== */
.sign-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-lg);
}

.tool-group {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.tool-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  font-weight: 500;
}

.color-options {
  display: flex;
  gap: var(--spacing-md);
}

.color-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast) var(--ease-out);
  background: var(--card-background);
}

.color-btn.active {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 6rpx rgba(25, 137, 250, 0.2);
}

.color-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.color-dot.black {
  background: #000000;
}

.color-dot.blue {
  background: #1A73E8;
}

.thickness-options {
  display: flex;
  gap: var(--spacing-sm);
}

.thickness-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast) var(--ease-out);
  background: var(--card-background);
}

.thickness-btn.active {
  border-color: var(--primary-color);
  background: var(--primary-color-light);
}

.thickness-line {
  width: 32rpx;
  background: #333;
  border-radius: 4rpx;
}

.thickness-line.thin {
  height: 2rpx;
}

.thickness-line.medium {
  height: 4rpx;
}

.thickness-line.thick {
  height: 6rpx;
}

/* ========== Canvas (签名画布) ========== */
.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 400rpx;
  border: 3rpx dashed var(--primary-color-light);
  border-radius: var(--radius-xl);
  background: var(--card-background);
  overflow: hidden;
}

.sign-canvas {
  width: 100%;
  height: 100%;
}

.canvas-placeholder {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  pointer-events: none;
}

.placeholder-icon {
  color: var(--text-color-placeholder);
}

.canvas-placeholder text {
  font-size: var(--font-size-md);
  color: var(--text-color-placeholder);
}

.clear-btn-wrapper {
  position: absolute;
  right: var(--spacing-md);
  bottom: var(--spacing-md);
  z-index: 10;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--spacing-xs) var(--spacing-md);
  background: rgba(0, 0, 0, 0.6);
  border-radius: var(--radius-full);
  color: var(--card-background);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.clear-btn:active {
  background: rgba(0, 0, 0, 0.8);
}

.sign-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--success-color-light);
  border-radius: var(--radius-md);
  color: var(--success-color);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

/* ========== Notice (注意事项) ========== */
.notice {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--warning-color-light);
  border-radius: var(--radius-lg);
  margin-top: var(--spacing-md);
}

.notice-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  line-height: 1.6;
}

/* ========== Submit Section (提交按钮区) ========== */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-background);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.submit-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  box-shadow: var(--shadow-md);
}
