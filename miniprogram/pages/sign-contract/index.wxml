<view class="page-container">
  <!-- ⭐ 错误提示（前置检查失败时显示）-->
  <view class="error-banner" wx:if="{{errorMessage}}">
    <view class="error-icon-wrapper">
      <van-icon name="warning-o" size="64rpx" color="var(--danger-color)" />
    </view>
    <text class="error-text">{{errorMessage}}</text>
    <button class="btn-return" bindtap="goBack">返回</button>
  </view>

  <!-- 加载中 -->
  <view class="loading-spinner" wx:if="{{loading && !errorMessage}}">
    <van-loading type="spinner" size="72rpx" color="var(--primary-color)" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 主内容 -->
  <view wx:if="{{!loading && !errorMessage}}">
    <!-- ⭐ 页面标题（根据signRole动态显示）-->
    <view class="page-header">
      <text class="page-title">{{signTitle}}</text>
      <text class="page-subtitle">
        合同编号: {{contractInfo.contract_no || '-'}}
      </text>
    </view>

    <!-- 合同摘要（只读）-->
    <view class="contract-summary card" wx:if="{{contractInfo}}">
      <view class="summary-row">
        <text class="summary-label">房屋地址</text>
        <text class="summary-value">{{contractInfo.house_address || '-'}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">月租金</text>
        <text class="summary-value price">¥{{contractInfo.monthly_rent || '0'}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">租赁期限</text>
        <text class="summary-value">
          {{contractInfo.lease_start_year || '-'}}.{{contractInfo.lease_start_month || '-'}}.{{contractInfo.lease_start_day || '-'}}
          ~
          {{contractInfo.lease_end_year || '-'}}.{{contractInfo.lease_end_month || '-'}}.{{contractInfo.lease_end_day || '-'}}
        </text>
      </view>
    </view>

    <!-- 签名区域 -->
    <view class="signature-area card">
      <view class="section-title-bar">请在下方签名</view>

      <!-- 签名工具栏 -->
      <view class="sign-toolbar">
        <!-- 颜色选择 -->
        <view class="tool-group">
          <text class="tool-label">颜色</text>
          <view class="color-options">
            <view
              class="color-btn {{currentColor === '#000000' ? 'active' : ''}}"
              data-color="#000000"
              bindtap="selectColor">
              <view class="color-dot black"></view>
            </view>
            <view
              class="color-btn {{currentColor === '#1A73E8' ? 'active' : ''}}"
              data-color="#1A73E8"
              bindtap="selectColor">
              <view class="color-dot blue"></view>
            </view>
          </view>
        </view>

        <!-- 粗细选择 -->
        <view class="tool-group">
          <text class="tool-label">粗细</text>
          <view class="thickness-options">
            <view
              class="thickness-btn {{currentThickness === 2 ? 'active' : ''}}"
              data-thickness="2"
              bindtap="selectThickness">
              <view class="thickness-line thin"></view>
            </view>
            <view
              class="thickness-btn {{currentThickness === 3 ? 'active' : ''}}"
              data-thickness="3"
              bindtap="selectThickness">
              <view class="thickness-line medium"></view>
            </view>
            <view
              class="thickness-btn {{currentThickness === 4 ? 'active' : ''}}"
              data-thickness="4"
              bindtap="selectThickness">
              <view class="thickness-line thick"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 签名画布 -->
      <view class="canvas-wrapper">
        <canvas
          id="signCanvas"
          type="2d"
          class="sign-canvas"
          bindtouchstart="handleTouchStart"
          bindtouchmove="handleTouchMove"
          bindtouchend="handleTouchEnd"
          bindtap="handleCanvasTap">
        </canvas>
        <view class="canvas-placeholder" wx:if="{{!hasSigned}}">
          <van-icon name="pencil-o" size="64rpx" class="placeholder-icon" />
          <text>请在此处签名</text>
        </view>
        <!-- 右下角清除按钮 -->
        <view class="clear-btn-wrapper" wx:if="{{hasSigned}}">
          <view class="clear-btn" bindtap="showClearConfirmDialog">
            <van-icon name="clear" size="18px" />
            <text>清除</text>
          </view>
        </view>
      </view>

      <!-- 签署提示 -->
      <view class="sign-hint" wx:if="{{hasSigned}}">
        <van-icon name="checked" size="28rpx" />
        <text>签名已生成，点击确认签署</text>
      </view>
    </view>

    <!-- ⭐ 注意事项 -->
    <view class="notice">
      <text class="notice-text">• 签名表示您已阅读并同意合同全部条款</text>
      <text class="notice-text">• 签名提交后将无法撤销</text>
      <text class="notice-text">• 请确保是本人操作</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section" wx:if="{{!loading && !errorMessage}}">
    <button
      class="submit-btn btn-primary"
      bindtap="submitSign"
      loading="{{isSubmitting}}"
      disabled="{{!hasSigned || isSubmitting}}">
      {{isSubmitting ? '签署中...' : '确认签署'}}
    </button>
  </view>
</view>
