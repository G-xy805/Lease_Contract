/* pages/login/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.login-form {
  padding: 40rpx 32rpx;
}

.code-btn {
  width: 160rpx;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0f9f0 0%, #e0f0e0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.tab-content {
  min-height: 400rpx;
}

.btn-icon {
  margin-right: 8rpx;
}

.login-tip {
  padding: 0 40rpx;
}

.login-tip .van-icon {
  vertical-align: middle;
  margin-right: 4rpx;
}