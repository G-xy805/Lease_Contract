/* pages/login/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.login-form {
  padding: 40rpx 32rpx;
}

.code-btn {
  width: 160rpx;
}

.switch-mode {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
  gap: 8rpx;
}