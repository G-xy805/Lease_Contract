<!-- pages/login/index.wxml -->
<view class="container">
  <view class="login-header">
    <view class="logo-placeholder">
      <van-icon name="shield-star" size="80rpx" color="#07c160" />
    </view>
    <view class="text-xl text-bold mt-md">租赁合同</view>
    <view class="text-sm text-gray mt-xs">签署便捷 · 安全可靠</view>
  </view>

  <view class="login-form card">
    <van-tabs active="{{ loginMode }}" bind:change="switchLoginMode" line-width="60px" wx:if="{{false}}">
      <van-tab title="手机号登录" name="phone"></van-tab>
      <van-tab title="微信登录" name="wechat"></van-tab>
    </van-tabs>

    <view class="tab-content">
      <van-field
        label="手机号"
        placeholder="请输入手机号"
        value="{{phone}}"
        type="number"
        maxlength="11"
        bind:change="onPhoneChange"
        disabled="{{codeSent}}"
      />

      <van-field
        label="验证码"
        placeholder="请输入验证码"
        value="{{code}}"
        type="number"
        maxlength="6"
        bind:change="onCodeChange"
      >
        <van-button
          slot="button"
          size="small"
          type="primary"
          round
          bind:click="onSendCode"
          loading="{{sendingCode}}"
          disabled="{{codeSent || phone.length !== 11}}"
          class="code-btn"
        >
          {{codeSent ? countdown + 's' : '获取验证码'}}
        </van-button>
      </van-field>

      <van-button
        type="primary"
        block
        round
        loading="{{loading}}"
        bind:click="handleLogin"
        class="mt-lg"
        disabled="{{!(phone.length === 11 && code.length === 6)}}"
      >
        登录
      </van-button>

      <van-divider hairline>或</van-divider>

      <van-button
        plain
        type="primary"
        block
        round
        loading="{{loading}}"
        bind:click="onWechatLogin"
        class="mt-md"
      >
        <van-icon name="wechat" class="btn-icon" />微信一键登录
      </van-button>
    </view>
  </view>

  <view class="text-center text-sm text-gray mt-lg">
    <text>登录即表示同意</text>
    <text class="text-primary">《用户协议》</text>和
    <text class="text-primary">《隐私政策》</text>
  </view>

  <view class="login-tip mt-xl text-center">
    <view class="text-xs text-gray">
      <van-icon name="info-o" size="28rpx" />
      首次登录将自动注册为乙方账户
    </view>
  </view>
</view>