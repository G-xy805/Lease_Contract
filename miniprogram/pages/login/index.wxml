<!-- pages/login/index.wxml -->
<view class="container">
  <!-- 品牌区域 -->
  <view class="brand-section">
    <view class="brand-logo-wrapper">
      <image class="brand-logo" src="/assets/images/logo.png" mode="aspectFit" />
    </view>
    <text class="brand-name">契约之约</text>
    <text class="brand-slogan">房屋租赁合同签署平台</text>
  </view>

  <!-- 登录表单 -->
  <view class="login-form">
    <view class="form-card">
      <view class="form-title">欢迎登录</view>
      <view class="form-subtitle">请输入您的手机号码登录</view>

      <!-- 手机号 -->
      <view class="form-item">
        <view class="form-label">
          <van-icon name="phone-o" class="label-icon" />
          <text>手机号码</text>
        </view>
        <van-field
          value="{{phone}}"
          placeholder="请输入手机号"
          type="number"
          maxlength="11"
          bind:change="onPhoneChange"
          clearable
          border="{{false}}"
          custom-class="custom-input"
          class="input-field"
        />
      </view>

      <!-- 验证码 -->
      <view class="form-item">
        <view class="form-label">
          <van-icon name="shield-o" class="label-icon" />
          <text>验证码</text>
        </view>
        <view class="code-input-wrapper">
          <van-field
            value="{{code}}"
            placeholder="请输入验证码"
            type="number"
            maxlength="6"
            bind:change="onCodeChange"
            border="{{false}}"
            custom-class="custom-input"
            class="code-input-field"
          />
          <van-button
            size="small"
            type="primary"
            round
            bind:click="onSendCode"
            disabled="{{countdown > 0}}"
            class="code-btn {{countdown > 0 ? 'code-btn-disabled' : ''}}"
          >
            {{countdown > 0 ? countdown + 's' : '获取验证码'}}
          </van-button>
        </view>
      </view>

      <!-- 协议 -->
      <view class="agreement-row">
        <van-checkbox value="{{agreed}}" bind:change="onAgreementChange" shape="round" icon-size="36rpx" class="agreement-checkbox">
          <view class="agreement-text">
            我已阅读并同意<text class="link" catchtap="showAgreement">《用户服务协议》</text>和<text class="link" catchtap="showPrivacy">《隐私政策》</text>
          </view>
        </van-checkbox>
      </view>

      <!-- 登录按钮 -->
      <van-button
        type="primary"
        size="large"
        round
        block
        bind:click="handleLogin"
        loading="{{loading}}"
        disabled="{{!canLogin}}"
        class="login-btn"
      >
        <text class="btn-text">{{loading ? '登录中...' : '登录'}}</text>
      </van-button>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-section">
    <view class="footer-divider">
      <view class="divider-line"></view>
      <text class="divider-text">登录即表示您同意</text>
      <view class="divider-line"></view>
    </view>
    <view class="footer-links">
      <text class="link" catchtap="showAgreement">服务条款</text>
      <text class="dot">·</text>
      <text class="link" catchtap="showPrivacy">隐私政策</text>
    </view>
  </view>
</view>