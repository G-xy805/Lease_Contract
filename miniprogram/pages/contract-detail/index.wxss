.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 200rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

/* 合同头部 */
.contract-header {
  background: linear-gradient(135deg, #1989fa 0%, #0c63e4 100%);
  color: white;
  padding: 40rpx 32rpx;
  text-align: center;
}

.contract-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.contract-no {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.contract-meta {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

/* 合同正文 */
.contract-body {
  padding: 24rpx;
}

.article {
  margin-bottom: 24rpx;
}

.preamble {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  text-indent: 2em;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1989fa;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1989fa;
}

.article-content {
  padding-left: 16rpx;
}

.sub-item {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 12rpx;
  text-indent: 2em;
}

.sub-item-bracket {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 12rpx;
  padding-left: 16rpx;
}

.sub-item-bracket2 {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 12rpx;
  padding-left: 32rpx;
}

/* 费用汇总表格 */
.fees-summary {
  margin-top: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.fees-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eee;
}

.fees-row:last-child {
  border-bottom: none;
}

.fees-label {
  font-size: 28rpx;
  color: #666;
}

.fees-value {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.fees-value.landlord {
  color: #1989fa;
}

/* 签署区域 */
.sign-section {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #ddd;
}

.sign-table {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sign-cell {
  width: 48%;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.sign-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.sign-value {
  font-size: 30rpx;
  color: #1989fa;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.sign-info {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.sign-date {
  text-align: center;
  margin-top: 24rpx;
}

.sign-date-item {
  font-size: 28rpx;
  color: #333;
}

.sign-date-value {
  color: #1989fa;
  font-weight: bold;
}

/* 物品清单表格 */
.items-grid {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.item-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.item-row.header {
  background: #e8f4ff;
  border-radius: 8rpx;
  font-weight: bold;
}

.item-row:last-child {
  border-bottom: none;
}

.item-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
}

.item-cell.name {
  flex: 1.5;
}

.item-cell.qty {
  flex: 0.5;
}

.meter-info {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* 签署状态 */
.sign-status {
  margin-top: 24rpx;
}

.sign-record {
  display: flex;
  justify-content: space-around;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.record-item.signed .record-icon {
  background: #07c160;
  color: #fff;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 备注文字 */
.remark-text {
  color: #666;
  font-style: italic;
}

/* 操作按钮区域 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-card {
  max-width: 700rpx;
  margin: 0 auto;
}

.primary-actions {
  margin-bottom: 24rpx;
}

.secondary-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-icon {
  margin-right: 8rpx;
}

/* 邀请码区域 */
.invite-code-section {
  margin-bottom: 24rpx;
}

.invite-code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.invite-code-label {
  font-size: 28rpx;
  color: #666;
}

.invite-code-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ee0a24;
  letter-spacing: 4rpx;
}

/* 分享弹窗 */
.share-modal {
  padding: 32rpx;
}

.share-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}

.share-modal-content {
  margin-bottom: 24rpx;
}

.invite-code-display {
  text-align: center;
  margin-bottom: 24rpx;
}

.invite-code-display .label {
  font-size: 28rpx;
  color: #666;
}

.invite-code-display .code {
  font-size: 40rpx;
  font-weight: bold;
  color: #ee0a24;
  letter-spacing: 6rpx;
}

.qr-code-box {
  text-align: center;
  margin-bottom: 24rpx;
}

.qr-code {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 12rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: #999;
}

.share-tip {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}

.share-modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
