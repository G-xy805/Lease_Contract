/* pages/contract-detail/index.wxss - Optimized v2 */

.container {
  min-height: 100vh;
  background: var(--background-color);
  display: flex;
  flex-direction: column;
}

/* ========== Loading ========== */
.loading-center {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

/* ========== Status Banner ========== */
.status-banner {
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
}

.status-bg-1 { background: var(--warning-color); }
.status-bg-2 { background: var(--warning-color); }
.status-bg-3 { background: var(--success-color); }
.status-bg-4 { background: var(--danger-color); }
.status-bg-5 { background: var(--text-color-tertiary); }
.status-bg-6 { background: var(--text-color-tertiary); }

.status-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-content {
  display: flex;
  align-items: center;
}

.status-icon {
  color: var(--text-color-inverse);
  font-size: 36rpx;
}

.status-text {
  color: var(--text-color-inverse);
  font-size: var(--font-size-lg);
  font-weight: 700;
}

/* ========== Content Scroll ========== */
.content-scroll {
  flex: 1;
  padding: var(--spacing-md);
  padding-bottom: 280rpx;
}

/* ========== Card ========== */
.card {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: all var(--transition-fast) var(--ease-out);
}

.card:active {
  transform: scale(0.995);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.card-title-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.card-icon {
  font-size: 36rpx;
  color: var(--primary-color);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

/* ========== Section Card (可折叠分组) ========== */
.section-card {
  padding: 0;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  cursor: pointer;
  transition: background-color var(--transition-fast);
}

.section-header:active {
  background-color: var(--background-color-light);
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

.section-arrow {
  color: var(--text-color-tertiary);
  transition: transform var(--transition-fast);
}

.section-content {
  transition: all var(--transition-normal) ease-in-out;
}

.section-content.expanded {
  padding: 0 var(--spacing-lg) var(--spacing-lg);
}

.section-content.collapsed {
  display: none;
}

.section-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

.subsection-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-color-secondary);
  margin-bottom: var(--spacing-sm);
  padding-left: var(--spacing-xs);
}

/* ========== Party Section (甲乙双方子分组) ========== */
.party-section {
  margin-bottom: var(--spacing-sm);
}

.party-section:last-child {
  margin-bottom: 0;
}

.party-section .party-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.party-section .party-badge-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.party-section .party-badge {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.party-section .party-a {
  background: var(--primary-color-light);
  color: var(--primary-color);
}

.party-section .party-b {
  background: var(--success-color-light);
  color: var(--success-color);
}

.party-section .party-company {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
}

.party-section .party-header-icon {
  color: var(--text-color-tertiary);
}

/* ========== Info Grid (甲乙双方信息网格) ========== */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-item-full {
  grid-column: span 2;
}

.info-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-weight: 500;
}

.info-value {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.info-value.phone-value {
  color: var(--primary-color);
}

.info-value.idcard-value {
  font-family: monospace;
  font-size: var(--font-size-sm);
}

.info-value.address-value {
  font-size: var(--font-size-sm);
  text-align: right;
  flex: 1;
  margin-left: var(--spacing-md);
}

.info-label-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.row-icon {
  color: var(--text-color-tertiary);
}

/* ========== Info List ========== */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

/* ========== Contract Info Card ========== */
.contract-info-card {
  text-align: center;
  padding: var(--spacing-xl);
}

.contract-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-md);
}

.contract-no-wrapper {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xs) var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-full);
}

.contract-no-icon {
  color: var(--text-color-tertiary);
}

.contract-no {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-family: monospace;
}

/* ========== Rent Card ========== */
.rent-card {
  background: linear-gradient(135deg, var(--primary-color-light) 0%, var(--card-background) 100%);
  border-color: var(--primary-color-light);
}

.rent-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--spacing-md);
  background: var(--card-background);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.rent-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.rent-secondary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.rent-divider {
  width: 2rpx;
  height: 80rpx;
  background: var(--border-color);
}

.rent-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.rent-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--danger-color);
}

.rent-value.secondary {
  font-size: var(--font-size-lg);
  color: var(--text-color-primary);
}

.deposit-chinese {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
}

.deposit-info-icon {
  color: var(--primary-color);
  flex-shrink: 0;
}

.deposit-chinese-text {
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
}

/* ========== Signature Section (⭐ 新版 - 从signatures数组渲染) ========== */
.signature-section {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.section-title-bar {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.signature-item {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.signature-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
}

.signature-role {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
}

.signature-status-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 600;
}

.signature-status-tag.signed {
  background: var(--success-color-light);
  color: var(--success-color);
}

.signature-status-tag.pending {
  background: var(--warning-color-light);
  color: var(--warning-color);
}

.signature-status-tag.waiting {
  background: var(--background-color-light);
  color: var(--text-color-tertiary);
}

.signature-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-lg);
}

.signature-image {
  width: 240rpx;
  height: 120rpx;
  background: var(--card-background);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.signature-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.signature-pending {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  background: var(--background-color-light);
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--border-color);
}

.text-secondary {
  color: var(--text-color-tertiary);
  font-size: var(--font-size-sm);
}

.signature-divider {
  height: 2rpx;
  background: var(--border-color);
  margin: var(--spacing-md) 0;
}

/* ========== Bottom Placeholder ========== */
.bottom-placeholder {
  height: 200rpx;
}

/* ========== Action Bar (⭐ 新版 - 动态按钮数组) ========== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-background);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.action-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  box-shadow: var(--shadow-md);
}

.btn-warning {
  background: var(--warning-color);
  color: #fff;
}

.btn-danger {
  background: var(--danger-color);
  color: #fff;
}

.btn-default {
  background: var(--background-color-light);
  color: var(--text-color-primary);
  border: 1rpx solid var(--border-color);
}

/* ========== Items Grid ========== */
.items-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
}

.item-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.item-name {
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
  margin-bottom: 4rpx;
  text-align: center;
}

.item-qty {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--primary-color);
}

/* ========== Fee Styles ========== */
.tenant-b {
  color: var(--success-color);
  font-weight: 600;
}

.tenant-a {
  color: var(--text-color-tertiary);
}

/* ========== Meter Styles ========== */
.meter-value {
  font-family: monospace;
  font-weight: 700;
  color: var(--primary-color);
}

/* ========== Account Value ========== */
.account-value {
  font-size: var(--font-size-sm);
  word-break: break-all;
  color: var(--text-color-secondary);
}

/* ========== Payment Card ========== */
.payment-card {
  background: linear-gradient(135deg, var(--warning-color-light, #FFF7E6) 0%, var(--card-background) 100%);
}

/* ========== Payment Split List ========== */
.payment-split-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-lg);
}

.payment-split-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx dashed var(--border-color-light);
}

.payment-split-item:last-child {
  border-bottom: none;
}

.payment-split-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.payment-split-title {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.payment-split-tip {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.payment-split-amount {
  font-size: var(--font-size-lg);
  color: var(--primary-color);
  font-weight: 600;
}

/* ========== Remark Content ========== */
.remark-content {
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
}

.remark-text {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  line-height: 1.6;
}

/* ========== Contract Full Content ========== */
.contract-full-content {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.contract-full-content .card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.contract-content-body {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text-color-primary);
  overflow-x: hidden;
}

.contract-content-body h1 {
  text-align: center;
  font-size: 32rpx;
  color: #0000FF;
  text-decoration: underline;
  margin-bottom: 30rpx;
}

.contract-content-body p {
  margin: 12rpx 0;
}

.contract-content-body .article-title {
  font-weight: bold;
  margin: 20rpx 0 10rpx 0;
}

.contract-content-body .content {
  text-indent: 2em;
  margin: 10rpx 0;
}

.contract-content-body .sub-item {
  padding-left: 2em;
  margin: 8rpx 0;
}

.contract-content-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 20rpx 0;
  font-size: 22rpx;
}

.contract-content-body table th,
.contract-content-body table td {
  border: 1rpx solid #000;
  padding: 8rpx;
  text-align: center;
}

.contract-content-body table th {
  background: #f0f0f0;
  font-weight: bold;
}

.contract-content-body img {
  max-width: 100%;
  height: auto;
}

/* ========== Mode Tabs (展示模式切换) ========== */
.mode-tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--card-background);
  margin: 0 var(--spacing-md);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.mode-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
  background: transparent;
  transition: all var(--transition-fast) var(--ease-out);
}

.mode-tab.active {
  color: var(--text-color-inverse);
  background: var(--primary-color);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* ========== Full Contract Scroll (完整合同滚动容器) ========== */
.full-contract-scroll {
  flex: 1;
  padding: var(--spacing-md);
  padding-bottom: 280rpx;
}

/* ========== Contract Rich Text (完整合同富文本) ========== */
.contract-rich-wrapper {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

/* ========== Contract Lines Content (结构化合同显示) ========== */
.contract-lines-wrapper {
  padding: var(--spacing-lg);
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.contract-line {
  margin-bottom: 16rpx;
}

.contract-line-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #1a1a1a;
  padding: 24rpx 0;
  border-bottom: 4rpx solid var(--primary-color);
  margin-bottom: 24rpx;
  text-decoration: underline;
}

.contract-line-section {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  background: linear-gradient(135deg, var(--primary-color-light) 0%, transparent 100%);
  padding: 16rpx 20rpx;
  border-left: 6rpx solid var(--primary-color);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  margin: 24rpx 0 16rpx 0;
}

.contract-line-paragraph {
  font-size: 28rpx;
  color: #444;
  line-height: 2;
  text-indent: 2em;
  text-align: justify;
  padding: 8rpx 0;
}

.contract-line-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  padding: 6rpx 0;
}

/* ========== Empty Full Content (空状态提示) ========== */
.empty-full-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  gap: var(--spacing-lg);
  min-height: 500rpx;
}

.empty-tip {
  text-align: center;
  max-width: 500rpx;
}

.empty-tip text {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  line-height: 1.6;
}

.try-download-btn {
  margin-top: var(--spacing-sm);
}
