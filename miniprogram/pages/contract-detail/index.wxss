/* pages/contract-detail/index.wxss - Optimized */

.container {
  min-height: 100vh;
  background: var(--background-color);
  display: flex;
  flex-direction: column;
}

/* ========== Loading ========== */
.loading-center {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

/* ========== Status Banner ========== */
.status-banner {
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
}

.status-bg-1 { background: var(--warning-color); }
.status-bg-2 { background: var(--warning-color); }
.status-bg-3 { background: var(--success-color); }
.status-bg-4 { background: var(--danger-color); }
.status-bg-5 { background: var(--text-color-tertiary); }
.status-bg-6 { background: var(--text-color-tertiary); }

.status-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-content {
  display: flex;
  align-items: center;
}

.status-icon {
  color: var(--text-color-inverse);
  font-size: 36rpx;
}

.status-text {
  color: var(--text-color-inverse);
  font-size: var(--font-size-lg);
  font-weight: 700;
}

/* ========== Content Scroll ========== */
.content-scroll {
  flex: 1;
  padding: var(--spacing-md);
  padding-bottom: 280rpx;
}

/* ========== Card ========== */
.card {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  transition: all var(--transition-fast) var(--ease-out);
}

.card:active {
  transform: scale(0.995);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.card-title-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.card-icon {
  font-size: 36rpx;
  color: var(--primary-color);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

/* ========== Contract Info Card ========== */
.contract-info-card {
  text-align: center;
  padding: var(--spacing-xl);
}

.contract-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-md);
}

.contract-no-wrapper {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
  padding: var(--spacing-xs) var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-full);
}

.contract-no-icon {
  color: var(--text-color-tertiary);
}

.contract-no {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-family: monospace;
}

/* ========== Party Card ========== */
.party-card {
  padding: var(--spacing-md);
}

.party-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.party-badge-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.party-badge {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.party-a {
  background: var(--primary-color-light);
  color: var(--primary-color);
}

.party-b {
  background: var(--success-color-light);
  color: var(--success-color);
}

.party-company {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
}

.party-header-icon {
  color: var(--text-color-tertiary);
}

/* ========== Info Grid ========== */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-weight: 500;
}

.info-value {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.info-value.phone-value {
  color: var(--primary-color);
}

.info-value.idcard-value {
  font-family: monospace;
  font-size: var(--font-size-sm);
}

.info-value.address-value {
  font-size: var(--font-size-sm);
  text-align: right;
}

.info-label-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.row-icon {
  color: var(--text-color-tertiary);
}

/* ========== Info List ========== */
.info-list {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

/* ========== Rent Card ========== */
.rent-card {
  background: linear-gradient(135deg, var(--primary-color-light) 0%, var(--card-background) 100%);
  border-color: var(--primary-color-light);
}

.rent-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--spacing-md);
  background: var(--card-background);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.rent-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.rent-secondary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.rent-divider {
  width: 2rpx;
  height: 80rpx;
  background: var(--border-color);
}

.rent-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.rent-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--danger-color);
}

.rent-value.secondary {
  font-size: var(--font-size-lg);
  color: var(--text-color-primary);
}

.deposit-chinese {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
}

.deposit-info-icon {
  color: var(--primary-color);
  flex-shrink: 0;
}

.deposit-chinese-text {
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
}

/* ========== Signature Card ========== */
.signature-card {
  background: var(--card-background);
}

.signature-area {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
}

.signature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
}

.signature-badge-wrapper {
  display: flex;
  justify-content: center;
}

.signature-badge {
  padding: 4rpx 16rpx;
  background: var(--success-color);
  color: var(--card-background);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 600;
}

.signature-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  font-weight: 500;
}

.signature-img {
  width: 200rpx;
  height: 100rpx;
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.signature-time {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.signature-divider {
  width: 2rpx;
  height: 120rpx;
  background: var(--border-color);
}

/* ========== Bottom Placeholder ========== */
.bottom-placeholder {
  height: 200rpx;
}

/* ========== Action Bar ========== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--card-background);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.action-row {
  display: flex;
  gap: var(--spacing-sm);
}

.action-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
}

.action-btn-half {
  flex: 1;
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
}

.primary-action,
.secondary-action {
  display: flex;
}

.primary-action .action-btn {
  box-shadow: var(--shadow-md);
}

.primary-btn .btn-icon,
.reject-btn .btn-icon {
  margin-right: var(--spacing-sm);
  font-size: 36rpx;
}

.edit-btn .btn-icon,
.delete-btn .btn-icon,
.share-btn .btn-icon,
.cancel-btn .btn-icon,
.download-btn .btn-icon {
  margin-right: var(--spacing-xs);
  font-size: 32rpx;
}

.btn-icon {
  flex-shrink: 0;
}

/* ========== Items Grid ========== */
.items-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
}

.item-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.item-name {
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
  margin-bottom: 4rpx;
  text-align: center;
}

.item-qty {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--primary-color);
}

/* ========== Fee Styles ========== */
.tenant-b {
  color: var(--success-color);
  font-weight: 600;
}

.tenant-a {
  color: var(--text-color-tertiary);
}

/* ========== Meter Styles ========== */
.meter-value {
  font-family: monospace;
  font-weight: 700;
  color: var(--primary-color);
}

/* ========== Account Value ========== */
.account-value {
  font-size: var(--font-size-sm);
  word-break: break-all;
  color: var(--text-color-secondary);
}

/* ========== Payment Card ========== */
.payment-card {
  background: linear-gradient(135deg, var(--warning-color-light, #FFF7E6) 0%, var(--card-background) 100%);
}

/* ========== Payment Split List ========== */
.payment-split-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-lg);
}

.payment-split-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx dashed var(--border-color-light);
}

.payment-split-item:last-child {
  border-bottom: none;
}

.payment-split-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.payment-split-title {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
}

.payment-split-tip {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.payment-split-amount {
  font-size: var(--font-size-lg);
  color: var(--primary-color);
  font-weight: 600;
}

/* ========== Remark Content ========== */
.remark-content {
  padding: var(--spacing-md);
  background: var(--background-color-light);
  border-radius: var(--radius-md);
}

.remark-text {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  line-height: 1.6;
}

/* ========== Card Content ========== */
.card-content {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  line-height: 1.8;
}

/* ========== Contract Full Content ========== */
.contract-full-content {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.contract-full-content .card-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.contract-content-body {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text-color-primary);
  overflow-x: hidden;
}

.contract-content-body h1 {
  text-align: center;
  font-size: 32rpx;
  color: #0000FF;
  text-decoration: underline;
  margin-bottom: 30rpx;
}

.contract-content-body p {
  margin: 12rpx 0;
}

.contract-content-body .article-title {
  font-weight: bold;
  margin: 20rpx 0 10rpx 0;
}

.contract-content-body .content {
  text-indent: 2em;
  margin: 10rpx 0;
}

.contract-content-body .sub-item {
  padding-left: 2em;
  margin: 8rpx 0;
}

.contract-content-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 20rpx 0;
  font-size: 22rpx;
}

.contract-content-body table th,
.contract-content-body table td {
  border: 1rpx solid #000;
  padding: 8rpx;
  text-align: center;
}

.contract-content-body table th {
  background: #f0f0f0;
  font-weight: bold;
}

.contract-content-body img {
  max-width: 100%;
  height: auto;
}

/* ========== Mode Tabs (展示模式切换) ========== */
.mode-tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--card-background);
  margin: 0 var(--spacing-md);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.mode-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
  background: transparent;
  transition: all var(--transition-fast) var(--ease-out);
}

.mode-tab.active {
  color: var(--text-color-inverse);
  background: var(--primary-color);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* ========== Full Contract Scroll (完整合同滚动容器) ========== */
.full-contract-scroll {
  flex: 1;
  padding: var(--spacing-md);
  padding-bottom: 280rpx;
}

/* ========== Full Contract Container (完整合同内容容器) ========== */
.full-contract-container {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  min-height: 400rpx;
}

.full-contract-container rich-text {
  font-size: 26rpx;
  line-height: 2;
  color: var(--text-color-primary);
}

/* ========== Empty Full Content (空状态提示) ========== */
.empty-full-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  gap: var(--spacing-lg);
  min-height: 500rpx;
}

.empty-tip {
  text-align: center;
  max-width: 500rpx;
}

.empty-tip text {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  line-height: 1.6;
}

.try-download-btn {
  margin-top: var(--spacing-sm);
}