<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-center">
    <van-loading type="spinner" size="72rpx" color="var(--primary-color)" />
    <text class="loading-text">加载合同数据...</text>
  </view>

  <block wx:if="{{!loading && contractInfo}}">
    <!-- 状态横幅 -->
    <view class="status-banner status-bg-{{contractInfo.status}}">
      <view class="status-icon-wrapper">
        <van-icon name="{{contractInfo.status === 3 ? 'passed' : 'clock-o'}}" class="status-icon" />
      </view>
      <view class="status-content">
        <text class="status-text">{{contractInfo.statusText}}</text>
      </view>
    </view>

    <!-- 主内容区域 -->
    <!-- 展示模式切换 -->
    <view class="mode-tabs">
      <view class="mode-tab {{displayMode === 'overview' ? 'active' : ''}}" bind:tap="switchToOverview">
        <van-icon name="list-switching" size="28rpx" />
        <text>概览</text>
      </view>
      <view class="mode-tab {{displayMode === 'full' ? 'active' : ''}}" bind:tap="switchToFull">
        <van-icon name="description" size="28rpx" />
        <text>完整合同</text>
      </view>
    </view>

    <!-- 概览模式内容 -->
    <block wx:if="{{displayMode === 'overview'}}">
    <scroll-view scroll-y class="content-scroll">
      <!-- 合同信息卡片 -->
      <view class="card contract-info-card">
        <view class="contract-icon-wrapper">
          <van-icon name="document-text" size="64rpx" color="var(--primary-color)" />
        </view>
        <text class="card-title">{{contractInfo.title}}</text>
        <view class="contract-no-wrapper">
          <van-icon name="qr" size="28rpx" class="contract-no-icon" />
          <text class="contract-no">No. {{contractInfo.contractNo}}</text>
        </view>
      </view>

      <!-- ========== 甲乙双方信息（可折叠）========== -->
      <view class="card section-card">
        <view class="section-header" bind:tap="toggleSection" data-section="partyInfo">
          <view class="section-title-wrapper">
            <van-icon name="user-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">甲乙双方信息</text>
          </view>
          <van-icon name="{{expandedSections.partyInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.partyInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.partyInfo}}">
          <!-- 甲方信息 -->
          <view class="party-section">
            <view class="party-header">
              <view class="party-badge party-a">甲方</view>
              <text class="party-company">{{contractInfo.partyA.company}}</text>
            </view>
            <view class="info-grid">
              <view class="info-item">
                <text class="info-label">联系电话</text>
                <text class="info-value phone-value">{{contractInfo.partyA.phone}}</text>
              </view>
              <view class="info-item" wx:if="{{contractInfo.partyA.contact}}">
                <text class="info-label">委托代理人</text>
                <text class="info-value">{{contractInfo.partyA.contact}}</text>
              </view>
            </view>
            <view class="info-grid" wx:if="{{contractInfo.partyA.agent.name || contractInfo.partyA.agent.phone}}">
              <view class="info-item" wx:if="{{contractInfo.partyA.agent.name}}">
                <text class="info-label">代理人姓名</text>
                <text class="info-value">{{contractInfo.partyA.agent.name}}</text>
              </view>
              <view class="info-item" wx:if="{{contractInfo.partyA.agent.phone}}">
                <text class="info-label">代理人电话</text>
                <text class="info-value phone-value">{{contractInfo.partyA.agent.phone}}</text>
              </view>
            </view>
            <view class="info-grid" wx:if="{{contractInfo.partyA.account}}">
              <view class="info-item info-item-full">
                <text class="info-label">收款账户</text>
                <text class="info-value account-value">{{contractInfo.partyA.account}}</text>
              </view>
            </view>
          </view>

          <view class="section-divider"></view>

          <!-- 乙方信息 -->
          <view class="party-section">
            <view class="party-header">
              <view class="party-badge party-b">乙方</view>
              <text class="party-company">{{contractInfo.partyB.name}}</text>
            </view>
            <view class="info-grid">
              <view class="info-item">
                <text class="info-label">联系电话</text>
                <text class="info-value phone-value">{{contractInfo.partyB.phone}}</text>
              </view>
              <view class="info-item" wx:if="{{contractInfo.partyB.idCard}}">
                <text class="info-label">身份证号</text>
                <text class="info-value idcard-value">{{contractInfo.partyB.idCard}}</text>
              </view>
            </view>
            <view class="info-grid" wx:if="{{contractInfo.partyB.contact}}">
              <view class="info-item info-item-full">
                <text class="info-label">委托代理人</text>
                <text class="info-value">{{contractInfo.partyB.contact}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 房屋及租赁信息（可折叠）========== -->
      <view class="card section-card">
        <view class="section-header" bind:tap="toggleSection" data-section="houseInfo">
          <view class="section-title-wrapper">
            <van-icon name="location-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">房屋及租赁信息</text>
          </view>
          <van-icon name="{{expandedSections.houseInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.houseInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.houseInfo}}">
          <!-- 房屋信息 -->
          <view class="info-list">
            <view class="info-row">
              <view class="info-label-wrapper">
                <van-icon name="location" size="28rpx" class="row-icon" />
                <text class="info-label">房屋地址</text>
              </view>
              <text class="info-value address-value">{{contractInfo.house.address}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.house.area}}">
              <view class="info-label-wrapper">
                <van-icon name="cluster-o" size="28rpx" class="row-icon" />
                <text class="info-label">建筑面积</text>
              </view>
              <text class="info-value">{{contractInfo.house.area}} ㎡</text>
            </view>
          </view>

          <view class="section-divider"></view>

          <!-- 租赁期限 -->
          <view class="info-list">
            <view class="info-row">
              <view class="info-label-wrapper">
                <van-icon name="clock-o" size="28rpx" class="row-icon" />
                <text class="info-label">租赁期限</text>
              </view>
              <text class="info-value">{{contractInfo.leasePeriod.start}} 至 {{contractInfo.leasePeriod.end}}</text>
            </view>
            <view class="info-row">
              <view class="info-label-wrapper">
                <van-icon name="calendar" size="28rpx" class="row-icon" />
                <text class="info-label">租赁总月数</text>
              </view>
              <text class="info-value">{{contractInfo.leasePeriod.months}} 个月</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.leasePeriod.purpose}}">
              <view class="info-label-wrapper">
                <van-icon name="apps-o" size="28rpx" class="row-icon" />
                <text class="info-label">租赁用途</text>
              </view>
              <text class="info-value">{{contractInfo.leasePeriod.purpose}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.leasePeriod.advanceNoticeDays}}">
              <view class="info-label-wrapper">
                <van-icon name="bell" size="28rpx" class="row-icon" />
                <text class="info-label">提前通知续租</text>
              </view>
              <text class="info-value">{{contractInfo.leasePeriod.advanceNoticeDays}} 天</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 租金及支付（可折叠）========== -->
      <view class="card section-card rent-card">
        <view class="section-header" bind:tap="toggleSection" data-section="leaseInfo">
          <view class="section-title-wrapper">
            <van-icon name="gold-coin-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">租金及支付</text>
          </view>
          <van-icon name="{{expandedSections.leaseInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.leaseInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.leaseInfo}}">
          <!-- 租金概要 -->
          <view class="rent-summary">
            <view class="rent-main">
              <text class="rent-label">月租金</text>
              <text class="rent-value">¥{{contractInfo.rent.monthly}}</text>
            </view>
            <view class="rent-divider"></view>
            <view class="rent-secondary">
              <text class="rent-label">押金</text>
              <text class="rent-value secondary">¥{{contractInfo.deposit.amount}}</text>
            </view>
          </view>

          <view class="deposit-chinese" wx:if="{{contractInfo.deposit.chinese}}">
            <van-icon name="info-o" size="24rpx" class="deposit-info-icon" />
            <text class="deposit-chinese-text">押金大写：{{contractInfo.deposit.chinese}}</text>
          </view>

          <view class="section-divider"></view>

          <!-- 支付详情 -->
          <view class="info-list">
            <view class="info-row">
              <view class="info-label-wrapper">
                <text class="info-label">支付方式</text>
              </view>
              <text class="info-value">{{contractInfo.rent.paymentMethod}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.rent.paymentCount > 1}}">
              <view class="info-label-wrapper">
                <text class="info-label">分期次数</text>
              </view>
              <text class="info-value">{{contractInfo.rent.paymentCount}} 次</text>
            </view>
          </view>

          <!-- 分次付款详情 -->
          <view class="payment-split-list" wx:if="{{contractInfo.rent.amounts.first}}">
            <view class="payment-split-item">
              <view class="payment-split-header">
                <text class="payment-split-title">第一次支付</text>
                <text class="payment-split-tip">签合同当日</text>
              </view>
              <view class="payment-split-amount">¥{{contractInfo.rent.amounts.first}}</view>
            </view>

            <view class="payment-split-item" wx:if="{{contractInfo.rent.amounts.second}}">
              <view class="payment-split-header">
                <text class="payment-split-title">第二次支付</text>
              </view>
              <view class="payment-split-amount">¥{{contractInfo.rent.amounts.second}}</view>
            </view>

            <view class="payment-split-item" wx:if="{{contractInfo.rent.amounts.third}}">
              <view class="payment-split-header">
                <text class="payment-split-title">第三次支付</text>
              </view>
              <view class="payment-split-amount">¥{{contractInfo.rent.amounts.third}}</view>
            </view>

            <view class="payment-split-item" wx:if="{{contractInfo.rent.amounts.fourth}}">
              <view class="payment-split-header">
                <text class="payment-split-title">第四次支付</text>
              </view>
              <view class="payment-split-amount">¥{{contractInfo.rent.amounts.fourth}}</view>
            </view>
          </view>

          <!-- 收款账户 -->
          <view class="info-list" wx:if="{{contractInfo.rent.account}}">
            <view class="info-row">
              <view class="info-label-wrapper">
                <van-icon name="credit-card" size="28rpx" class="row-icon" />
                <text class="info-label">指定收款账户</text>
              </view>
              <text class="info-value account-value">{{contractInfo.rent.account}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 费用及物品（可折叠）========== -->
      <view class="card section-card">
        <view class="section-header" bind:tap="toggleSection" data-section="feeInfo">
          <view class="section-title-wrapper">
            <van-icon name="balance-list-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">费用约定及物品</text>
          </view>
          <van-icon name="{{expandedSections.feeInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.feeInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.feeInfo}}">
          <!-- 费用承担 -->
          <view class="subsection-title" wx:if="{{contractInfo.feeItems.length > 0}}">
            <text>费用承担</text>
          </view>
          <view class="info-list" wx:if="{{contractInfo.feeItems.length > 0}}">
            <view class="info-row" wx:for="{{contractInfo.feeItems}}" wx:key="name">
              <view class="info-label-wrapper">
                <text class="info-label">{{item.name}}</text>
              </view>
              <text class="info-value {{item.checked ? 'tenant-b' : 'tenant-a'}}">{{item.checked ? '乙方承担' : '甲方承担'}}</text>
            </view>
          </view>

          <!-- 表读数 -->
          <view class="subsection-title" wx:if="{{contractInfo.meters.electricity || contractInfo.meters.water || contractInfo.meters.gas}}">
            <text>表读数</text>
          </view>
          <view class="info-list" wx:if="{{contractInfo.meters.electricity || contractInfo.meters.water || contractInfo.meters.gas}}">
            <view class="info-row" wx:if="{{contractInfo.meters.electricity}}">
              <view class="info-label-wrapper">
                <text class="info-label">电表读数</text>
              </view>
              <text class="info-value meter-value">{{contractInfo.meters.electricity}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.meters.water}}">
              <view class="info-label-wrapper">
                <text class="info-label">水表读数</text>
              </view>
              <text class="info-value meter-value">{{contractInfo.meters.water}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.meters.gas}}">
              <view class="info-label-wrapper">
                <text class="info-label">燃气表读数</text>
              </view>
              <text class="info-value meter-value">{{contractInfo.meters.gas}}</text>
            </view>
          </view>

          <!-- 物品清单 -->
          <view class="subsection-title" wx:if="{{contractInfo.inventoryItems.length > 0}}">
            <text>租赁房屋物品清单</text>
          </view>
          <view class="items-grid" wx:if="{{contractInfo.inventoryItems.length > 0}}">
            <view class="item-card" wx:for="{{contractInfo.inventoryItems}}" wx:key="name">
              <text class="item-name">{{item.name}}</text>
              <text class="item-qty">{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 中介信息（可折叠）========== -->
      <view class="card section-card" wx:if="{{contractInfo.intermediary.name}}">
        <view class="section-header" bind:tap="toggleSection" data-section="intermediaryInfo">
          <view class="section-title-wrapper">
            <van-icon name="friends-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">居间服务（中介）</text>
          </view>
          <van-icon name="{{expandedSections.intermediaryInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.intermediaryInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.intermediaryInfo}}">
          <view class="info-list">
            <view class="info-row">
              <view class="info-label-wrapper">
                <text class="info-label">中介名称</text>
              </view>
              <text class="info-value">{{contractInfo.intermediary.name}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.intermediary.commissionA}}">
              <view class="info-label-wrapper">
                <text class="info-label">甲方佣金</text>
              </view>
              <text class="info-value">¥{{contractInfo.intermediary.commissionA}}</text>
            </view>
            <view class="info-row" wx:if="{{contractInfo.intermediary.commissionB}}">
              <view class="info-label-wrapper">
                <text class="info-label">乙方佣金</text>
              </view>
              <text class="info-value">¥{{contractInfo.intermediary.commissionB}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 备注（可折叠）========== -->
      <view class="card section-card" wx:if="{{contractInfo.remark}}">
        <view class="section-header" bind:tap="toggleSection" data-section="remarkInfo">
          <view class="section-title-wrapper">
            <van-icon name="comment-o" size="32rpx" color="var(--primary-color)" />
            <text class="section-title">备注</text>
          </view>
          <van-icon name="{{expandedSections.remarkInfo ? 'arrow-up' : 'arrow-down'}}" size="32rpx" class="section-arrow" />
        </view>

        <view class="section-content {{expandedSections.remarkInfo ? 'expanded' : 'collapsed'}}" wx:if="{{expandedSections.remarkInfo}}">
          <view class="remark-content">
            <text class="remark-text">{{contractInfo.remark}}</text>
          </view>
        </view>
      </view>

      <!-- ========== 签名区域 ========== -->
      <view class="signature-section card" wx:if="{{contractInfo.status >= 1 && contractInfo.status <= 3}}">
        <view class="section-title-bar">签署信息</view>

        <!-- 甲方签名 -->
        <view class="signature-item">
          <view class="signature-header">
            <text class="signature-role">甲方签署</text>
            <view class="signature-status-tag {{contractInfo.partyASigned ? 'signed' : (contractInfo.status === 1 ? 'pending' : 'waiting')}}">
              <text>{{contractInfo.partyASigned ? '已签署' : (contractInfo.status === 1 ? '待签署' : '等待中')}}</text>
            </view>
          </view>
          <view class="signature-body" wx:if="{{contractInfo.partyASigned && contractInfo.lessorSignature}}">
            <image wx:if="{{contractInfo.lessorSignature.signature_data}}"
                   class="signature-image"
                   src="{{contractInfo.lessorSignature.signature_data}}"
                   mode="aspectFit" />
            <view class="signature-meta">
              <text>签署人: {{contractInfo.lessorSignature.sign_name}}</text>
              <text>时间: {{contractInfo.lessorSignature.signed_at}}</text>
            </view>
          </view>
          <view class="signature-pending" wx:else>
            <text class="text-secondary">待甲方签署...</text>
          </view>
        </view>

        <view class="signature-divider"></view>

        <!-- 乙方签名 -->
        <view class="signature-item">
          <view class="signature-header">
            <text class="signature-role">乙方签署</text>
            <view class="signature-status-tag {{contractInfo.partyBSigned ? 'signed' : (contractInfo.status >= 2 ? (contractInfo.status === 2 ? 'pending' : 'waiting') : 'waiting')}}">
              <text>{{contractInfo.partyBSigned ? '已签署' : (contractInfo.status === 2 ? '待签署' : '等待中')}}</text>
            </view>
          </view>
          <view class="signature-body" wx:if="{{contractInfo.partyBSigned && contractInfo.lesseeSignature}}">
            <image wx:if="{{contractInfo.lesseeSignature.signature_data}}"
                   class="signature-image"
                   src="{{contractInfo.lesseeSignature.signature_data}}"
                   mode="aspectFit" />
            <view class="signature-meta">
              <text>签署人: {{contractInfo.lesseeSignature.sign_name}}</text>
              <text>时间: {{contractInfo.lesseeSignature.signed_at}}</text>
            </view>
          </view>
          <view class="signature-pending" wx:else>
            <text class="text-secondary">待乙方签署...</text>
          </view>
        </view>
      </view>

      <!-- 合同全文 -->
      <view wx:if="{{contractInfo.content}}" class="contract-full-content">
        <view class="card-header">
          <view class="card-title-wrapper">
            <van-icon name="description" size="32rpx" color="var(--primary-color)" />
            <text class="card-title">合同全文</text>
          </view>
        </view>
        <view class="contract-content-body">
          <rich-text nodes="{{contractInfo.content}}" />
        </view>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>
    </block>

    <!-- 完整合同模式内容 -->
    <block wx:if="{{displayMode === 'full'}}">
    <scroll-view scroll-y class="full-contract-scroll">
      <!-- 有完整合同时 -->
      <block wx:if="{{contractInfo.contentLines.length > 0}}">
        <view class="contract-lines-wrapper">
          <block wx:for="{{contractInfo.contentLines}}" wx:key="index">
            <view class="contract-line contract-line-{{item.type}}">
              <text>{{item.content}}</text>
            </view>
          </block>
        </view>
      </block>

      <!-- 无完整合同时显示提示 -->
      <view wx:if="{{!contractInfo.contentLines.length}}" class="empty-full-content">
        <van-empty image="search" description="暂无完整合同内容" />
        <view class="empty-tip">
          <text>合同全文正在生成中，请稍后再试或下载PDF查看</text>
        </view>
        <van-button type="primary" size="small" round bind:click="onDownloadPdf" class="try-download-btn">
          下载PDF查看
        </van-button>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>
    </block>

    <!-- 动态按钮区 -->
    <view class="action-bar" wx:if="{{buttons.length > 0}}">
      <block wx:for="{{buttons}}" wx:key="action">
        <button
          class="action-btn btn-{{item.type}}"
          data-action="{{item.action}}"
          bindtap="onActionTap"
        >
          {{item.text}}
        </button>
      </block>
    </view>
  </block>
</view>
