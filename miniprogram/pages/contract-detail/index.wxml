<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-center">
    <van-loading type="spinner" size="72rpx" color="var(--primary-color)" />
    <text class="loading-text">加载合同数据...</text>
  </view>

  <block wx:if="{{!loading && contractInfo}}">
    <!-- 状态横幅 -->
    <view class="status-banner status-bg-{{contractStatus}}">
      <view class="status-icon-wrapper">
        <van-icon name="{{statusIcon}}" class="status-icon" />
      </view>
      <view class="status-content">
        <text class="status-text">{{statusText}}</text>
      </view>
    </view>

    <!-- 主内容区域 -->
    <scroll-view scroll-y class="content-scroll">
      <!-- 合同信息卡片 -->
      <view class="card contract-info-card">
        <view class="contract-icon-wrapper">
          <van-icon name="document-text" size="64rpx" color="var(--primary-color)" />
        </view>
        <text class="card-title">{{contractInfo.title}}</text>
        <view class="contract-no-wrapper">
          <van-icon name="qr" size="28rpx" class="contract-no-icon" />
          <text class="contract-no">No. {{contractNo}}</text>
        </view>
      </view>

      <!-- 甲方信息 -->
      <view class="card party-card party-a-card">
        <view class="party-header">
          <view class="party-badge-wrapper">
            <view class="party-badge party-a">甲方</view>
            <text class="party-company">{{contractInfo.partyA.company}}</text>
          </view>
          <van-icon name="user-o" size="40rpx" class="party-header-icon" />
        </view>
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">联系人</text>
            <text class="info-value">{{contractInfo.partyA.contact || '-'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">联系电话</text>
            <text class="info-value phone-value">{{contractInfo.partyA.phone}}</text>
          </view>
        </view>
      </view>

      <!-- 乙方信息 -->
      <view class="card party-card party-b-card">
        <view class="party-header">
          <view class="party-badge-wrapper">
            <view class="party-badge party-b">乙方</view>
            <text class="party-company">{{contractInfo.partyB.name}}</text>
          </view>
          <van-icon name="user-o" size="40rpx" class="party-header-icon" />
        </view>
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">联系电话</text>
            <text class="info-value phone-value">{{contractInfo.partyB.phone || '-'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">身份证号</text>
            <text class="info-value idcard-value">{{contractInfo.partyB.idCard || '-'}}</text>
          </view>
        </view>
      </view>

      <!-- 房屋信息 -->
      <view class="card">
        <view class="card-header">
          <view class="card-title-wrapper">
            <van-icon name="location-o" class="card-icon" />
            <text class="card-title">房屋信息</text>
          </view>
        </view>
        <view class="info-list">
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="location" size="28rpx" class="row-icon" />
              <text class="info-label">房产位置</text>
            </view>
            <text class="info-value address-value">{{contractInfo.property.address}}</text>
          </view>
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="cluster-o" size="28rpx" class="row-icon" />
              <text class="info-label">建筑面积</text>
            </view>
            <text class="info-value">{{contractInfo.property.area}} ㎡</text>
          </view>
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="shop-o" size="28rpx" class="row-icon" />
              <text class="info-label">租赁用途</text>
            </view>
            <text class="info-value">{{contractInfo.property.purpose}}</text>
          </view>
        </view>
      </view>

      <!-- 租赁信息 -->
      <view class="card rent-card">
        <view class="card-header">
          <view class="card-title-wrapper">
            <van-icon name="calendar-o" class="card-icon" />
            <text class="card-title">租赁信息</text>
          </view>
        </view>
        <view class="rent-summary">
          <view class="rent-main">
            <text class="rent-label">月租金</text>
            <text class="rent-value">¥{{contractInfo.rent.monthly}}</text>
          </view>
          <view class="rent-divider"></view>
          <view class="rent-secondary">
            <text class="rent-label">押金</text>
            <text class="rent-value secondary">¥{{contractInfo.rent.deposit}}</text>
          </view>
          <view class="rent-divider" wx:if="{{contractInfo.rent.totalAmount > 0}}"></view>
          <view class="rent-secondary" wx:if="{{contractInfo.rent.totalAmount > 0}}">
            <text class="rent-label">总租金</text>
            <text class="rent-value secondary">¥{{contractInfo.rent.totalAmount}}</text>
          </view>
        </view>
        <view class="info-list">
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="clock-o" size="28rpx" class="row-icon" />
              <text class="info-label">租赁期限</text>
            </view>
            <text class="info-value">{{contractInfo.lease.startDate}} 至 {{contractInfo.lease.endDate}}</text>
          </view>
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="calendar" size="28rpx" class="row-icon" />
              <text class="info-label">租赁月数</text>
            </view>
            <text class="info-value">{{contractInfo.lease.months}} 个月</text>
          </view>
          <view class="info-row">
            <view class="info-label-wrapper">
              <van-icon name="shop-o" size="28rpx" class="row-icon" />
              <text class="info-label">租赁用途</text>
            </view>
            <text class="info-value">{{contractInfo.property.purpose}}</text>
          </view>
          <view class="info-row" wx:if="{{contractInfo.lease.advanceNoticeDays}}">
            <view class="info-label-wrapper">
              <van-icon name="warning-o" size="28rpx" class="row-icon" />
              <text class="info-label">提前通知</text>
            </view>
            <text class="info-value">提前 {{contractInfo.lease.advanceNoticeDays}} 日告知是否续租</text>
          </view>
        </view>
        <view class="deposit-chinese">
          <van-icon name="info-o" size="24rpx" class="deposit-info-icon" />
          <text class="deposit-chinese-text">押金大写：{{contractInfo.rent.depositChinese}}</text>
        </view>
      </view>

       <!-- 付款详情 -->
       <view class="card payment-card">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="gold-coin-o" size="32rpx" color="var(--primary-color)" />
             <text class="card-title">付款详情</text>
           </view>
         </view>
         <view class="info-list">
           <view class="info-row">
             <view class="info-label-wrapper">
               <text class="info-label">付款方式</text>
             </view>
             <text class="info-value">{{contractInfo.rent.paymentMethod}}</text>
           </view>
           <view class="info-row" wx:if="{{contractInfo.rent.paymentCycle}}">
             <view class="info-label-wrapper">
               <text class="info-label">支付周期</text>
             </view>
             <text class="info-value">每 {{contractInfo.rent.paymentCycle}} 月支付一次</text>
           </view>
           <view class="info-row" wx:if="{{contractInfo.rent.paymentCount > 1}}">
             <view class="info-label-wrapper">
               <text class="info-label">分期次数</text>
             </view>
             <text class="info-value">{{contractInfo.rent.paymentCount}} 次</text>
           </view>
         </view>

         <!-- 分次付款详情 -->
         <view class="payment-split-list">
           <view class="payment-split-item">
             <view class="payment-split-header">
               <text class="payment-split-title">第一次支付</text>
               <text class="payment-split-tip">签合同当日</text>
             </view>
             <view class="payment-split-amount">¥{{contractInfo.rent.firstPaymentAmount}}</view>
           </view>

           <view class="payment-split-item" wx:if="{{contractInfo.rent.paymentCount >= 2}}">
             <view class="payment-split-header">
               <text class="payment-split-title">第二次支付</text>
               <text class="payment-split-tip" wx:if="{{contractInfo.rent.secondPaymentDate}}">{{contractInfo.rent.secondPaymentDate}}</text>
             </view>
             <view class="payment-split-amount">¥{{contractInfo.rent.secondPaymentAmount}}</view>
           </view>

           <view class="payment-split-item" wx:if="{{contractInfo.rent.paymentCount >= 3}}">
             <view class="payment-split-header">
               <text class="payment-split-title">第三次支付</text>
             </view>
             <view class="payment-split-amount">¥{{contractInfo.rent.thirdPaymentAmount}}</view>
           </view>

           <view class="payment-split-item" wx:if="{{contractInfo.rent.paymentCount >= 4}}">
             <view class="payment-split-header">
               <text class="payment-split-title">第四次支付</text>
             </view>
             <view class="payment-split-amount">¥{{contractInfo.rent.fourthPaymentAmount}}</view>
           </view>
         </view>

         <view class="info-list" wx:if="{{contractInfo.partyA.account}}">
           <view class="info-row">
             <view class="info-label-wrapper">
               <van-icon name="credit-card" size="28rpx" class="row-icon" />
               <text class="info-label">收款账户</text>
             </view>
             <text class="info-value account-value">{{contractInfo.partyA.account}}</text>
           </view>
         </view>
       </view>

       <!-- 费用承担 -->
       <view class="card" wx:if="{{contractInfo.fees.length > 0}}">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="balance-list-o" size="32rpx" color="var(--primary-color)" />
             <text class="card-title">费用承担</text>
           </view>
         </view>
         <view class="info-list">
           <view class="info-row" wx:for="{{contractInfo.fees}}" wx:key="label">
             <view class="info-label-wrapper">
               <text class="info-label">{{item.label}}</text>
             </view>
             <text class="info-value {{item.tenant === '乙方承担' ? 'tenant-b' : 'tenant-a'}}">{{item.tenant}}</text>
           </view>
         </view>
       </view>

       <!-- 表读数 -->
       <view class="card" wx:if="{{contractInfo.meters.length > 0}}">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="bar-chart-o" size="32rpx" color="var(--primary-color)" />
             <text class="card-title">表读数</text>
           </view>
         </view>
         <view class="info-list">
           <view class="info-row" wx:for="{{contractInfo.meters}}" wx:key="label">
             <view class="info-label-wrapper">
               <text class="info-label">{{item.label}}</text>
             </view>
             <text class="info-value meter-value">{{item.value}}</text>
           </view>
         </view>
       </view>

       <!-- 物品清单 -->
       <view class="card" wx:if="{{contractInfo.items.length > 0}}">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="apps-o" size="32rpx" color="var(--primary-color)" />
             <text class="card-title">租赁房屋物品清单</text>
           </view>
         </view>
         <view class="items-grid">
           <view class="item-card" wx:for="{{contractInfo.items}}" wx:key="name">
             <text class="item-name">{{item.name}}</text>
             <text class="item-qty">{{item.quantity}}</text>
           </view>
         </view>
       </view>

       <!-- 中介信息 -->
      <view class="card" wx:if="{{contractInfo.intermediary.name}}">
        <view class="card-header">
          <view class="card-title-wrapper">
            <van-icon name="friends-o" size="32rpx" color="var(--primary-color)" />
            <text class="card-title">居间服务（中介）</text>
          </view>
        </view>
        <view class="info-list">
          <view class="info-row">
            <view class="info-label-wrapper">
              <text class="info-label">中介名称</text>
            </view>
            <text class="info-value">{{contractInfo.intermediary.name}}</text>
          </view>
          <view class="info-row" wx:if="{{contractInfo.intermediary.partyACommission}}">
            <view class="info-label-wrapper">
              <text class="info-label">甲方佣金</text>
            </view>
            <text class="info-value">¥{{contractInfo.intermediary.partyACommission}}（{{contractInfo.intermediary.partyACommissionChinese}}）</text>
          </view>
          <view class="info-row" wx:if="{{contractInfo.intermediary.partyBCommission}}">
            <view class="info-label-wrapper">
              <text class="info-label">乙方佣金</text>
            </view>
            <text class="info-value">¥{{contractInfo.intermediary.partyBCommission}}（{{contractInfo.intermediary.partyBCommissionChinese}}）</text>
          </view>
        </view>
      </view>

      <!-- 备注 -->
      <view class="card" wx:if="{{contractInfo.remark}}">
        <view class="card-header">
          <view class="card-title-wrapper">
            <van-icon name="comment-o" size="32rpx" color="var(--primary-color)" />
            <text class="card-title">备注</text>
          </view>
        </view>
        <view class="remark-content">
          <text class="remark-text">{{contractInfo.remark}}</text>
        </view>
      </view>

      <!-- 签署信息 -->
       <view class="card signature-card" wx:if="{{partyASignature || partyBSignature}}">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="edit" class="card-icon" />
             <text class="card-title">签署信息</text>
           </view>
         </view>
         <view class="signature-area">
           <view class="signature-item" wx:if="{{partyASignature}}">
             <view class="signature-badge-wrapper">
               <view class="signature-badge">已签署</view>
             </view>
             <view class="signature-label">甲方签名</view>
             <image class="signature-img" src="{{partyASignature}}" mode="aspectFit" />
             <text class="signature-time" wx:if="{{partyASignTime}}">
               <van-icon name="clock-o" size="24rpx" />
               {{partyASignTime}}
             </text>
           </view>
           <view class="signature-divider" wx:if="{{partyASignature && partyBSignature}}"></view>
           <view class="signature-item" wx:if="{{partyBSignature}}">
             <view class="signature-badge-wrapper">
               <view class="signature-badge">已签署</view>
             </view>
             <view class="signature-label">乙方签名</view>
             <image class="signature-img" src="{{partyBSignature}}" mode="aspectFit" />
             <text class="signature-time" wx:if="{{partyBSignTime}}">
               <van-icon name="clock-o" size="24rpx" />
               {{partyBSignTime}}
             </text>
           </view>
         </view>
       </view>

       <!-- 合同全文 -->
       <view wx:if="{{contractInfo.content}}" class="contract-full-content">
         <view class="card-header">
           <view class="card-title-wrapper">
             <van-icon name="description" size="32rpx" color="var(--primary-color)" />
             <text class="card-title">合同全文</text>
           </view>
         </view>
         <view class="contract-content-body">
           <rich-text nodes="{{contractInfo.content}}" />
         </view>
       </view>

       <!-- 底部占位 -->
       <view class="bottom-placeholder"></view>
    </scroll-view>

    <!-- 操作按钮区域 -->
    <view class="action-bar" wx:if="{{showSignBtn || showEditBtn || showDeleteBtn || showShareBtn || showCancelBtn || showRejectBtn || showDownloadBtn}}">
      <view class="primary-action" wx:if="{{showSignBtn}}">
        <van-button type="primary" size="large" round block bind:click="onSign" class="action-btn primary-btn">
          <van-icon name="sign" class="btn-icon" />
          确认签署
        </van-button>
      </view>

      <view class="action-row" wx:if="{{showEditBtn || showDeleteBtn}}">
        <van-button wx:if="{{showEditBtn}}" type="default" size="large" round block bind:click="onEditContract" class="action-btn-half edit-btn">
          <van-icon name="edit-o" class="btn-icon" />
          编辑
        </van-button>
        <van-button wx:if="{{showDeleteBtn}}" type="danger" plain size="large" round block bind:click="onDeleteContract" class="action-btn-half delete-btn">
          <van-icon name="delete-o" class="btn-icon" />
          删除
        </van-button>
      </view>

      <view class="action-row" wx:if="{{showShareBtn || showCancelBtn}}">
        <van-button wx:if="{{showShareBtn}}" type="primary" plain size="large" round block bind:click="onGenerateShare" class="action-btn-half share-btn">
          <van-icon name="link-o" class="btn-icon" />
          生成分享链接
        </van-button>
        <van-button wx:if="{{showCancelBtn}}" type="default" plain size="large" round block bind:click="onCancelContract" class="action-btn-half cancel-btn">
          <van-icon name="cross" class="btn-icon" />
          取消合同
        </van-button>
      </view>

      <view class="primary-action" wx:if="{{showRejectBtn}}">
        <van-button type="warning" size="large" round block bind:click="onRejectContract" class="action-btn reject-btn">
          <van-icon name="warning-o" class="btn-icon" />
          拒绝签署
        </van-button>
      </view>

      <view class="secondary-action" wx:if="{{showDownloadBtn}}">
        <van-button type="default" size="large" round block bind:click="onDownloadPdf" class="action-btn download-btn">
          <van-icon name="down" class="btn-icon" />
          下载合同PDF
        </van-button>
      </view>
    </view>
  </block>
</view>