<!-- pages/preview-contract/index.wxml - 预览合同页（v2重构版） -->
<view class="container">
  <block wx:if="{{loading}}">
    <view class="loading-container">
      <van-loading type="spinner" size="60rpx" color="var(--primary-color)" />
      <text class="loading-text">加载合同数据...</text>
    </view>
  </block>

  <block wx:elif="{{contractData}}">
    <scroll-view scroll-y class="preview-scroll">
      <!-- 合同标题卡片 -->
      <view class="contract-header">
        <view class="contract-icon">
          <van-icon name="document-text" size="64rpx" color="#ffffff" />
        </view>
        <view class="contract-title">房屋租赁合同</view>
        <view class="contract-subtitle">{{contractData.title || '预览合同'}}</view>
        <status-tag type="{{contractStatus === 3 ? 'success' : contractStatus === 2 ? 'warning' : contractStatus === 4 ? 'danger' : 'primary'}}" text="{{statusText}}" size="medium" />
      </view>

      <!-- 合同基本信息 -->
      <view class="card">
        <form-section title="合同信息" icon="info-circle">
          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">合同编号</text>
              <text class="info-value">{{contractNo}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">合同状态</text>
              <status-tag type="{{contractStatus === 3 ? 'success' : contractStatus === 2 ? 'warning' : 'primary'}}" text="{{statusText}}" size="small" />
            </view>
          </view>
        </form-section>
      </view>

      <view class="section-divider"></view>

      <!-- 甲乙双方信息 -->
      <view class="card party-card">
        <form-section title="一、甲乙双方信息" icon="user-o">

          <!-- 甲方信息 -->
          <view class="party-section lessor">
            <view class="party-label-wrapper">
              <view class="party-dot lessor-dot"></view>
              <view class="party-label">甲方（出租方）</view>
            </view>
            <view class="info-grid">
              <view class="info-item">
                <text class="info-label">公司名称</text>
                <text class="info-value">{{lessorInfo.company}}</text>
              </view>
              <view class="info-item" wx:if="{{lessorInfo.name}}">
                <text class="info-label">联系人</text>
                <text class="info-value">{{lessorInfo.name}}</text>
              </view>
              <view class="info-item">
                <text class="info-label">联系电话</text>
                <text class="info-value">{{lessorInfo.phone}}</text>
              </view>
              <view class="info-item" wx:if="{{lessorInfo.phone2}}">
                <text class="info-label">备用电话</text>
                <text class="info-value">{{lessorInfo.phone2}}</text>
              </view>
            </view>
          </view>

          <view class="party-divider"></view>

          <!-- 乙方信息 -->
          <view class="party-section lessee">
            <view class="party-label-wrapper">
              <view class="party-dot lessee-dot"></view>
              <view class="party-label">乙方（承租方）</view>
            </view>
            <view class="info-grid">
              <view class="info-item">
                <text class="info-label">姓名</text>
                <text class="info-value">{{lesseeInfo.name}}</text>
              </view>
              <view class="info-item">
                <text class="info-label">联系电话</text>
                <text class="info-value">{{lesseeInfo.phone}}</text>
              </view>
            </view>
          </view>

        </form-section>
      </view>

      <view class="section-divider"></view>

      <!-- 房屋和租赁信息 -->
      <view class="card" wx:if="{{houseInfo.address}}">
        <form-section title="二、房屋信息" icon="home-o">
          <view class="info-grid">
            <view class="info-item full-width">
              <text class="info-label">房屋地址</text>
              <text class="info-value">{{houseInfo.address}}</text>
            </view>
            <view class="info-item" wx:if="{{houseInfo.area}}">
              <text class="info-label">房屋面积</text>
              <text class="info-value">{{houseInfo.area}} 平方米</text>
            </view>
          </view>
        </form-section>
      </view>

      <view class="section-divider" wx:if="{{houseInfo.address}}"></view>

      <!-- 租赁期限 -->
      <view class="card" wx:if="{{leaseInfo.leaseStart}}">
        <form-section title="三、租赁期限" icon="clock-o">
          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">租赁开始</text>
              <text class="info-value highlight">{{leaseInfo.leaseStart}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">租赁结束</text>
              <text class="info-value highlight">{{leaseInfo.leaseEnd}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">租赁月数</text>
              <text class="info-value highlight">{{leaseInfo.months}} 个月</text>
            </view>
          </view>
        </form-section>
      </view>

      <view class="section-divider" wx:if="{{leaseInfo.leaseStart}}"></view>

      <!-- 租金和押金信息 -->
      <view class="card rent-card">
        <form-section title="四、租金和押金" icon="cash-o">
          <view class="rent-highlight">
            <view class="rent-main">
              <text class="rent-label">月租金</text>
              <text class="rent-value">¥{{rentInfo.monthlyRentFormatted}}</text>
            </view>
            <view class="rent-divider"></view>
            <view class="rent-secondary">
              <text class="rent-label">押金</text>
              <text class="rent-value secondary">¥{{depositInfo.formatted}}</text>
            </view>
          </view>
          <view class="info-grid" wx:if="{{rentInfo.yearRent || depositInfo.chinese}}">
            <view class="info-item" wx:if="{{rentInfo.yearRent}}">
              <text class="info-label">租金总计</text>
              <text class="info-value">¥{{rentInfo.yearRentFormatted}}</text>
            </view>
            <view class="info-item" wx:if="{{depositInfo.chinese}}">
              <text class="info-label">押金大写</text>
              <text class="info-value">{{depositInfo.chinese}}</text>
            </view>
          </view>
        </form-section>
      </view>

      <view class="section-divider"></view>

      <!-- 支付方式 -->
      <view class="card">
        <form-section title="五、支付方式" icon="card">
          <view class="payment-method">
            <view class="payment-method-item">
              <van-icon name="todo-list-o" size="40rpx" class="payment-icon" />
              <view class="payment-method-info">
                <text class="payment-method-label">支付方式</text>
                <text class="payment-method-value">{{rentInfo.paymentCycleText}}</text>
              </view>
            </view>
            <view class="payment-method-item">
              <van-icon name="records" size="40rpx" class="payment-icon" />
              <view class="payment-method-info">
                <text class="payment-method-label">支付次数</text>
                <text class="payment-method-value">{{rentInfo.paymentCount}} 次</text>
              </view>
            </view>
          </view>
        </form-section>
      </view>

      <!-- 物品清单 -->
      <view class="section-divider" wx:if="{{inventoryItems.length > 0}}"></view>
      <view class="card" wx:if="{{inventoryItems.length > 0}}">
        <form-section title="六、房屋物品清单" icon="orders-o">
          <view class="inventory-grid">
            <view class="inventory-item" wx:for="{{inventoryItems}}" wx:key="index">
              <view class="inventory-icon-wrapper">
                <van-icon name="gift-o" size="32rpx" />
              </view>
              <text class="item-name">{{item.name}}</text>
              <text class="item-qty">x{{item.quantity}}{{item.unit}}</text>
            </view>
          </view>
        </form-section>
      </view>

      <!-- 费用约定 -->
      <view class="section-divider" wx:if="{{fees.length > 0}}"></view>
      <view class="card" wx:if="{{fees.length > 0}}">
        <form-section title="七、费用约定" icon="bill-o">
          <view class="fees-list">
            <view class="fee-item" wx:for="{{fees}}" wx:key="index">
              <text class="fee-label">{{item.label}}</text>
              <text class="fee-value {{item.tenant == '甲方承担' ? 'owner' : ''}}">{{item.tenant}}</text>
            </view>
          </view>
        </form-section>
      </view>

      <!-- 备注 -->
      <view class="section-divider" wx:if="{{remark}}"></view>
      <view class="card" wx:if="{{remark}}">
        <form-section title="备注" icon="edit-o">
          <view class="remark-text">{{remark}}</view>
        </form-section>
      </view>

      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <van-button
        type="default"
        size="large"
        round
        bind:click="goBackToEdit"
        class="bottom-bar-btn edit-btn"
      >
        <van-icon name="arrow-left" class="btn-icon" />
        返回编辑
      </van-button>
      <van-button
        type="primary"
        size="large"
        round
        bind:click="onSubmit"
        class="bottom-bar-btn submit-btn"
      >
        <van-icon name="success" class="btn-icon" />
        确认提交
      </van-button>
    </view>
  </block>

  <block wx:else>
    <empty-state image="error" title="暂无合同数据" description="无法加载预览数据，请返回重试" />
  </block>
</view>
