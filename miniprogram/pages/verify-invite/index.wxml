<view class="page-container">
  <!-- ⭐ 状态1: 加载中 -->
  <view class="loading-state" wx:if="{{verifyStatus === 'loading'}}">
    <van-loading type="spinner" size="72rpx" color="var(--primary-color)" />
    <text class="loading-text">正在验证邀请码...</text>
  </view>

  <!-- ⭐ 状态2: 验证通过 + 合同预览 -->
  <block wx:if="{{verifyStatus === 'valid'}}">
    <!-- 成功标识 -->
    <view class="success-header">
      <view class="success-icon-wrapper">
        <van-icon name="passed" size="96rpx" color="#fff" />
      </view>
      <text class="success-title">邀请验证通过</text>
      <text class="success-subtitle">您已被邀请签署以下合同</text>
    </view>

    <!-- ⭐ 合同摘要卡片 -->
    <view class="contract-preview card" wx:if="{{contractInfo}}">
      <view class="preview-header">
        <van-icon name="document-text" size="40rpx" class="preview-icon" />
        <text class="preview-title">合同信息</text>
      </view>

      <view class="preview-row">
        <text class="preview-label">合同名称</text>
        <text class="preview-value">{{contractInfo.title || '-'}}</text>
      </view>

      <view class="preview-row">
        <text class="preview-label">房屋地址</text>
        <text class="preview-value address">{{contractInfo.house_address || '-'}}</text>
      </view>

      <view class="preview-row highlight">
        <text class="preview-label">月租金</text>
        <text class="preview-value price">¥{{contractInfo.monthly_rent || '0'}}</text>
      </view>

      <view class="preview-row">
        <text class="preview-label">甲方（出租方）</text>
        <text class="preview-value party">{{contractInfo.partyA_company || contractInfo.lessor_name || '-'}}</text>
      </view>

      <view class="preview-divider"></view>

      <view class="preview-meta">
        <text class="meta-item">合同编号: {{contractInfo.contract_no || '-'}}</text>
        <text class="meta-item">创建时间: {{contractInfo.created_at || '-'}}</text>
      </view>
    </view>

    <!-- ⭐ 未登录 → 引导登录 -->
    <view class="action-prompt" wx:if="{{!isLoggedIn}}">
      <view class="prompt-icon-wrapper login">
        <van-icon name="user-o" size="64rpx" />
      </view>
      <text class="prompt-title">需要登录</text>
      <text class="prompt-desc">登录后即可查看完整合同并进行签署操作</text>
      <button class="btn-primary btn-large" bindtap="onLogin">立即登录</button>
    </view>

    <!-- ⭐ 已登录未认证 → 引导实名认证 -->
    <view class="action-prompt" wx:if="{{isLoggedIn && !isVerified}}">
      <view class="prompt-icon-wrapper verify">
        <van-icon name="shield-o" size="64rpx" />
      </view>
      <text class="prompt-title">需要实名认证</text>
      <text class="prompt-desc">完成实名认证后方可签署合同</text>
      <button class="btn-primary btn-large" bindtap="onGoVerify">去实名认证</button>
    </view>

    <!-- ⭐ 已登录已认证 → 显示操作按钮 -->
    <view class="action-buttons" wx:if="{{showActions}}">
      <button
        class="btn-primary btn-large"
        bindtap="onAcceptAndSign">
        接受并签署
      </button>

      <view class="btn-group-secondary">
        <button class="btn-danger" bindtap="onReject">拒绝邀请</button>
        <button class="btn-default" bindtap="onLater">稍后再说</button>
      </view>

      <!-- 联系甲方 -->
      <view class="contact-party-a" bindtap="contactPartyA">
        <van-icon name="phone-o" size="32rpx" />
        <text>联系甲方咨询</text>
      </view>
    </view>
  </block>

  <!-- ⭐ 状态3-6: 各种错误/特殊状态 -->
  <view class="error-state" wx:if="{{verifyStatus !== 'loading' && verifyStatus !== 'valid'}}">
    <!-- 使用 empty-state 组件显示不同状态 -->
    <empty-state
      type="{{verifyStatus === 'expired' ? 'error' : (verifyStatus === 'accepted' || verifyStatus === 'refused') ? 'info' : 'no-permission'}}"
      title="{{verifyStatus === 'expired' ? '邀请已过期' : verifyStatus === 'accepted' ? '已被接受' : verifyStatus === 'refused' ? '已被拒绝' : '无效的邀请码'}}"
      description="{{errorMessage}}"
    />

    <!-- 操作按钮 -->
    <view class="error-actions">
      <button
        wx:if="{{verifyStatus === 'invalid'}}"
        class="btn-primary"
        bindtap="onRetry">
        重新输入
      </button>

      <button
        class="btn-default"
        bindtap="goBack">
        返回首页
      </button>
    </view>
  </view>
</view>
