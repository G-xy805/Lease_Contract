/* pages/verify-invite/index.wxss - v2 (完整乙方流程) */

.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding: var(--spacing-lg);
  box-sizing: border-box;
}

/* ========== Loading State (状态1: 加载中) ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: var(--spacing-lg);
}

.loading-text {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
}

/* ========== Success Header (验证通过头部) ========== */
.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
  padding: var(--spacing-xl) 0;
}

.success-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.3);
}

.success-title {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--success-color);
  letter-spacing: 1rpx;
}

.success-subtitle {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
}

/* ========== Card (通用卡片) ========== */
.card {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

/* ========== Contract Preview (合同预览卡片) ========== */
.contract-preview {
  background: linear-gradient(135deg, rgba(25, 137, 250, 0.05) 0%, var(--card-background) 100%);
  border-color: var(--primary-color-light);
}

.preview-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.preview-icon {
  color: var(--primary-color);
}

.preview-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-color-light);
}

.preview-row:last-of-type {
  border-bottom: none;
}

.preview-row.highlight {
  background: rgba(255, 235, 59, 0.15);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) calc(-1 * var(--spacing-md));
  border-left: 6rpx solid #FFC107;
  border-radius: var(--radius-md);
}

.preview-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  font-weight: 500;
  flex-shrink: 0;
  width: 200rpx;
}

.preview-value {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.preview-value.address {
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.preview-value.price {
  color: var(--danger-color);
  font-weight: 700;
  font-size: var(--font-size-lg);
}

.preview-value.party {
  color: var(--primary-color);
  font-weight: 600;
}

.preview-divider {
  height: 2rpx;
  background: linear-gradient(to right, transparent, var(--border-color), transparent);
  margin: var(--spacing-md) 0;
}

.preview-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: var(--spacing-sm);
}

.meta-item {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  font-family: monospace;
}

/* ========== Action Prompt (操作提示区 - 未登录/未认证) ========== */
.action-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  border: 2rpx dashed var(--border-color);
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
}

.prompt-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.prompt-icon-wrapper.login {
  background: var(--primary-color-light);
  color: var(--primary-color);
}

.prompt-icon-wrapper.verify {
  background: var(--warning-color-light);
  color: var(--warning-color);
}

.prompt-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-xs);
}

.prompt-desc {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  text-align: center;
  line-height: 1.5;
  max-width: 500rpx;
  margin-bottom: var(--spacing-md);
}

/* ========== Action Buttons (操作按钮区 - 已认证用户) ========== */
.action-buttons {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-xl);
  padding: var(--spacing-lg);
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.btn-large {
  width: 100%;
  height: 104rpx;
  font-size: var(--font-size-lg);
  font-weight: 700;
  border-radius: var(--radius-xl);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), #1565C0);
  color: #fff;
}

.btn-group-secondary {
  display: flex;
  gap: var(--spacing-md);
  width: 100%;
}

.btn-danger {
  flex: 1;
  height: 88rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  background: var(--danger-color);
  color: #fff;
  border-radius: var(--radius-lg);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-default {
  flex: 1;
  height: 88rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  background: var(--background-color-light);
  color: var(--text-color-primary);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-party-a {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-md);
  margin-top: var(--spacing-sm);
  color: var(--primary-color);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.contact-party-a:active {
  opacity: 0.7;
}

/* ========== Error State (错误/特殊状态) ========== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx var(--spacing-lg);
  gap: var(--spacing-xl);
  min-height: 60vh;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  width: 100%;
  max-width: 400rpx;
}
