.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #969799;
}

.input-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}

.verify-btn {
  margin-top: 40rpx;
}

.error-text {
  display: block;
  color: #ee0a24;
  font-size: 24rpx;
  text-align: center;
  margin-top: 20rpx;
}

.contract-info {
  margin-top: 30rpx;
}

.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #969799;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #323233;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
  word-break: break-all;
}

.price {
  color: #ee0a24;
  font-weight: 600;
}

.action-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.reject-btn {
  margin-top: 20rpx;
}

.status-tip {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.login-tip {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.login-tip text {
  font-size: 28rpx;
  color: #969799;
}