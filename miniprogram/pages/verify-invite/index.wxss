/* pages/verify-invite/index.wxss - Optimized */

.container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 0;
}

/* ========== Header ========== */
.header {
  background-color: var(--card-background);
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
  border-bottom: 1rpx solid var(--border-color);
}

.header-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-md);
}

.title {
  display: block;
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-xs);
}

.subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
}

/* ========== Loading ========== */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  background-color: var(--background-color);
}

.loading-animation {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.loading-text {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
}

/* ========== Error ========== */
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--spacing-lg);
  background-color: var(--background-color);
}

.error-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--danger-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.error-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-sm);
}

.error-message {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  text-align: center;
  margin-bottom: var(--spacing-lg);
  max-width: 500rpx;
}

.back-btn {
  width: 400rpx;
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
}

.btn-icon {
  margin-right: var(--spacing-xs);
  font-size: 32rpx;
}

/* ========== Result Section ========== */
.result-section {
  padding: var(--spacing-md) var(--spacing-md);
}

.status-tip {
  margin-bottom: var(--spacing-md);
}

/* ========== Info Card ========== */
.info-card {
  background-color: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 2rpx solid var(--border-color);
}

.card-title-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.card-icon {
  color: var(--primary-color);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--text-color-primary);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.info-label-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.info-icon {
  color: var(--text-color-tertiary);
}

.label {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  flex-shrink: 0;
}

.value {
  font-size: var(--font-size-sm);
  color: var(--text-color-primary);
  text-align: right;
  flex: 1;
  margin-left: var(--spacing-md);
  word-break: break-all;
}

.value.contract-no {
  font-family: monospace;
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
}

.value.address {
  font-size: var(--font-size-xs);
}

.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: var(--spacing-sm) 0;
}

/* ========== Price Row ========== */
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--spacing-md);
  background: var(--primary-color-light);
  border-radius: var(--radius-lg);
  margin-top: var(--spacing-sm);
}

.price-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.price-divider {
  width: 2rpx;
  height: 80rpx;
  background: var(--border-color);
}

.price-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.price-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--danger-color);
}

.price-value.secondary {
  font-size: var(--font-size-lg);
  color: var(--text-color-primary);
}

/* ========== Action Section ========== */
.action-section {
  background-color: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.action-highlight {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--success-color-light);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.action-tip {
  font-size: var(--font-size-sm);
  color: var(--text-color-primary);
}

.primary-action-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  box-shadow: var(--shadow-md);
}

.primary-action-btn .btn-icon {
  margin-right: var(--spacing-sm);
}

/* ========== Contact Section ========== */
.contact-section {
  background-color: var(--card-background);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--background-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-color-tertiary);
  margin-bottom: var(--spacing-md);
}

.contact-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-sm);
}

.contact-message {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: var(--spacing-lg);
  max-width: 500rpx;
}

.contact-btn {
  width: 100%;
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
}

.contact-btn .btn-icon {
  margin-right: var(--spacing-sm);
}

/* ========== Expired Section ========== */
.action-section.expired {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
}

.expired-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--warning-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.expired-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-sm);
}

.expired-message {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: var(--spacing-lg);
  max-width: 500rpx;
}

.back-action-btn {
  width: 100%;
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
}

.back-action-btn .btn-icon {
  margin-right: var(--spacing-sm);
}