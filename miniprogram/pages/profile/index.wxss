.profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #1989fa 0%, #0077ff 100%);
  padding: 60rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.user-info-header {
  display: flex;
  align-items: center;
}

.avatar {
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-details {
  margin-left: 30rpx;
  flex: 1;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.verified-tag {
  background-color: rgba(7, 193, 96, 0.2) !important;
  border-color: #07c160 !important;
}

.pending-tag {
  background-color: rgba(255, 152, 0, 0.2) !important;
  border-color: #ff976a !important;
}

.phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}

/* 实名认证区域 */
.auth-section {
  margin: 24rpx;
  margin-top: -20rpx;
}

.auth-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.auth-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.auth-card.unverified .auth-icon {
  background-color: rgba(25, 137, 250, 0.1);
}

.auth-card.pending .auth-icon {
  background-color: rgba(255, 152, 0, 0.1);
}

.auth-card.verified .auth-icon {
  background-color: rgba(7, 193, 96, 0.1);
}

.auth-content {
  flex: 1;
  margin-left: 24rpx;
}

.auth-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #323233;
  display: block;
}

.auth-desc {
  font-size: 24rpx;
  color: #969799;
  margin-top: 6rpx;
  display: block;
}

/* 设置区域 */
.settings-section {
  margin: 24rpx;
}

.cell-label {
  font-size: 26rpx;
  color: #969799;
}

.idcard-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.idcard-preview {
  border-radius: 8rpx;
}

/* 退出登录 */
.logout-section {
  margin: 60rpx 24rpx 0;
}

.logout-btn {
  background-color: #ffffff !important;
  color: #ee0a24 !important;
  border: none !important;
}

/* 弹窗样式 */
.popup-content {
  padding: 32rpx;
}

.popup-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #323233;
}

.nickname-input {
  background-color: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.popup-footer {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.popup-footer van-button {
  flex: 1;
}

/* 身份证上传弹窗 */
.idcard-popup {
  min-height: 600rpx;
}

.idcard-upload-area {
  margin-bottom: 32rpx;
}

.idcard-item {
  margin-bottom: 32rpx;
}

.idcard-label-text {
  font-size: 28rpx;
  color: #646566;
  display: block;
  margin-bottom: 16rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-btn text {
  font-size: 24rpx;
  color: #969799;
}