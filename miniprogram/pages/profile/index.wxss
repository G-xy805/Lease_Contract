/* pages/profile/index.wxss */
.profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 60rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  background: linear-gradient(135deg, #1989fa 0%, #0077ff 100%);
  padding: 60rpx 40rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.15) 0%, transparent 50%);
}

.user-info-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-border {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.user-details {
  margin-left: 30rpx;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.role-tag {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
}

.role-tenant {
  background-color: rgba(7, 193, 96, 0.6);
}

.phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  display: block;
}

/* 实名认证状态卡片 */
.auth-status-card {
  margin: 24rpx;
  margin-top: -40rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.status-header {
  padding: 24rpx 32rpx 0;
}

.status-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
}

.status-content {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-top: 16rpx;
}

.status-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-content.unverified .status-icon-wrap {
  background-color: rgba(150, 150, 150, 0.15);
}

.status-content.pending .status-icon-wrap {
  background-color: rgba(255, 152, 106, 0.15);
}

.status-content.verified .status-icon-wrap {
  background-color: rgba(7, 193, 96, 0.15);
}

.status-info {
  flex: 1;
  margin-left: 24rpx;
}

.status-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #969799;
  display: block;
}

.status-label.pending-text {
  color: #ff976a;
}

.status-label.verified-text {
  color: #07c160;
}

.status-desc {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
  display: block;
}

/* 功能入口分组 */
.menu-section {
  margin: 24rpx;
}

.menu-group {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.group-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f5f5f5;
}

.group-title text {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-item-left text {
  font-size: 30rpx;
  color: #323233;
}

/* 底部信息 */
.footer-section {
  margin: 40rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.version-text {
  font-size: 24rpx;
  color: #c8c9cc;
}

.logout-btn {
  background-color: #ffffff !important;
  color: #ee0a24 !important;
  border: none !important;
}

/* 身份信息弹窗 */
.popup-content {
  padding: 32rpx;
}

.popup-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #323233;
}

.id-info-list {
  margin-bottom: 32rpx;
}

.id-info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.id-info-item:last-child {
  border-bottom: none;
}

.id-info-label {
  font-size: 28rpx;
  color: #646566;
}

.id-info-value {
  font-size: 28rpx;
  color: #323233;
}

.popup-footer {
  display: flex;
  justify-content: center;
}

.popup-footer van-button {
  width: 200rpx;
}
