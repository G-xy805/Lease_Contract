/* pages/profile/index.wxss - Optimized */

.profile-page {
  min-height: 100vh;
  background-color: var(--background-color);
  padding-bottom: var(--spacing-xxl);
}

/* ========== Loading ========== */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

/* ========== User Card ========== */
.user-card {
  position: relative;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  padding: calc(var(--spacing-xl) + var(--spacing-xxl)) var(--spacing-lg) var(--spacing-xl);
  border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.18) 0%, transparent 50%);
}

.user-info-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  animation: fadeInUp var(--transition-slow) var(--ease-out);
}

.avatar-wrapper {
  position: relative;
  margin-bottom: var(--spacing-md);
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.1) 100%);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.02); }
}

.avatar {
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.user-details {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.name-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xs);
}

.nickname {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--card-background);
  letter-spacing: -0.01em;
}

.role-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  font-size: var(--font-size-xs);
  color: var(--card-background);
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: var(--radius-full);
  font-weight: 500;
}

.role-icon {
  font-size: 22rpx;
}

.role-tenant {
  background-color: rgba(var(--success-color-rgb), 0.6);
}

.phone-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.phone-icon {
  color: rgba(255, 255, 255, 0.7);
}

.phone {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* ========== Role Switch ========== */
.role-switch {
  display: flex;
  justify-content: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.role-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.7);
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  transition: all var(--transition-fast) var(--ease-out);
  font-weight: 500;
}

.role-btn.active {
  color: var(--card-background);
  background-color: rgba(255, 255, 255, 0.4);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* ========== Auth Card ========== */
.auth-card {
  margin: calc(var(--spacing-md) * -1);
  margin-top: -30rpx;
  padding: 0 var(--spacing-md);
  position: relative;
  z-index: 10;
}

.auth-group {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
}

.auth-status {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.auth-btn {
  margin-left: var(--spacing-xs);
}

.auth-text {
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.auth-text.unverified {
  color: var(--text-color-tertiary);
}

.auth-text.authenticating {
  color: var(--warning-color);
}

.auth-text.verified {
  color: var(--success-color);
}

.auth-text.failed {
  color: var(--danger-color);
}

/* ========== Menu Section ========== */
.menu-section {
  margin: var(--spacing-lg) var(--spacing-md);
}

.menu-card {
  background: var(--card-background);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
}

.menu-group {
  padding: var(--spacing-md);
}

.menu-group-title {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-sm);
  padding-left: var(--spacing-xs);
}

.menu-group-icon {
  font-size: 32rpx;
  color: var(--primary-color);
}

.menu-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 0 var(--spacing-md);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast) var(--ease-out);
  margin: 0 -var(--spacing-md);
  padding-left: calc(var(--spacing-md) + var(--spacing-sm));
  padding-right: calc(var(--spacing-md) + var(--spacing-sm));
}

.menu-item:first-of-type {
  padding-top: 0;
}

.menu-item:last-of-type {
  padding-bottom: 0;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.menu-icon {
  font-size: 36rpx;
  color: var(--text-color-secondary);
}

.menu-text {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
}

/* ========== Logout Section ========== */
.logout-section {
  margin: var(--spacing-xl) var(--spacing-md) 0;
}

.logout-btn {
  height: 96rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  background-color: var(--card-background) !important;
  color: var(--danger-color) !important;
  border: 1rpx solid var(--danger-color-light) !important;
  box-shadow: var(--shadow-sm);
}

.logout-icon {
  margin-right: var(--spacing-xs);
  font-size: 36rpx;
}

/* ========== Version Section ========== */
.version-section {
  display: flex;
  justify-content: center;
  margin-top: var(--spacing-xl);
}

.version-text {
  font-size: var(--font-size-xs);
  color: var(--text-color-placeholder);
  letter-spacing: 0.05em;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}