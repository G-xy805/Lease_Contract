<view class="profile-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <van-loading type="spinner" size="60rpx" color="var(--primary-color)">加载中...</van-loading>
  </view>

  <block wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="card-bg"></view>
      <view class="user-info-content">
        <view class="avatar-wrapper">
          <view class="avatar-ring"></view>
          <van-image
            round
            width="140rpx"
            height="140rpx"
            src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}"
            class="avatar"
          />
        </view>
        <view class="user-details">
          <view class="name-row">
            <text class="nickname">{{userInfo.name || '未设置昵称'}}</text>
            <view class="role-tag" wx:if="{{currentRole === 'LESSOR'}}">
              <van-icon name="home-o" class="role-icon" />
              甲方
            </view>
            <view class="role-tag role-admin" wx:elif="{{currentRole === 'ADMIN'}}">
              <van-icon name="setting-o" class="role-icon" />
              管理员
            </view>
            <view class="role-tag role-tenant" wx:else>
              <van-icon name="user-o" class="role-icon" />
              乙方
            </view>
          </view>
          <view class="phone-row">
            <van-icon name="phone-o" size="28rpx" class="phone-icon" />
            <text class="phone">{{userInfo.phone || '未绑定手机'}}</text>
          </view>
        </view>
      </view>

      <!-- 角色切换 -->
      <view class="role-switch" wx:if="{{userInfo.has_lessor_role && userInfo.has_lessee_role}}">
        <view
          class="role-btn {{currentRole === 'LESSOR' ? 'active' : ''}}"
          data-role="LESSOR"
          bindtap="switchRole"
        >
          甲方
        </view>
        <view
          class="role-btn {{currentRole === 'LESSEE' ? 'active' : ''}}"
          data-role="LESSEE"
          bindtap="switchRole"
        >
          乙方
        </view>
      </view>
    </view>

    <!-- 实名认证状态 -->
    <view class="auth-card">
      <van-cell-group border="{{false}}" class="auth-group">
        <van-cell
          title="实名认证"
          center
          border="{{false}}"
        >
          <!-- 未认证 -->
          <view wx:if="{{userInfo.real_name_status === REAL_NAME_STATUS.NOT_AUTH}}" slot="right-icon" class="auth-status">
            <text class="auth-text unverified">未认证</text>
            <van-button type="primary" size="small" round bindtap="goToRealNameAuth" class="auth-btn">
              去认证
            </van-button>
          </view>
          <!-- 认证中 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.AUTHENTICATING}}" slot="right-icon" class="auth-status">
            <van-loading size="32rpx" />
            <text class="auth-text authenticating">认证中</text>
          </view>
          <!-- 已认证 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.AUTHENTICATED}}" slot="right-icon" class="auth-status verified">
            <van-icon name="passed" size="36rpx" color="var(--success-color)" />
            <text class="auth-text verified">已认证</text>
          </view>
          <!-- 认证失败 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.FAILED}}" slot="right-icon" class="auth-status">
            <text class="auth-text failed">认证失败</text>
            <van-button type="danger" size="small" round bindtap="goToRealNameAuth" class="auth-btn">
              重新认证
            </van-button>
          </view>
        </van-cell>
      </van-cell-group>
    </view>

    <!-- 功能列表 -->
    <view class="menu-section">
      <view class="menu-card">
        <view class="menu-group">
          <view class="menu-group-title">
            <van-icon name="orders-o" class="menu-group-icon" />
            <text>合同管理</text>
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToMyCreatedContracts"
          >
            <view class="menu-item-left">
              <van-icon name="plus-circle-o" class="menu-icon" />
              <text class="menu-text">我创建的合同</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToMySignedContracts"
          >
            <view class="menu-item-left">
              <van-icon name="sign-o" class="menu-icon" />
              <text class="menu-text">我签署的合同</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
        </view>

        <view class="menu-divider"></view>

        <view class="menu-group">
          <view class="menu-group-title">
            <van-icon name="idcard" class="menu-group-icon" />
            <text>身份认证</text>
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToRealNameAuth"
          >
            <view class="menu-item-left">
              <van-icon name="certificate" class="menu-icon" />
              <text class="menu-text">实名认证</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToIdInfo"
          >
            <view class="menu-item-left">
              <van-icon name="user-o" class="menu-icon" />
              <text class="menu-text">身份信息</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
        </view>

        <view class="menu-divider"></view>

        <view class="menu-group">
          <view class="menu-group-title">
            <van-icon name="setting-o" class="menu-group-icon" />
            <text>设置与帮助</text>
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToSettings"
          >
            <view class="menu-item-left">
              <van-icon name="setting-o" class="menu-icon" />
              <text class="menu-text">设置</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToHelp"
          >
            <view class="menu-item-left">
              <van-icon name="question-o" class="menu-icon" />
              <text class="menu-text">帮助与反馈</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
          <view
            class="menu-item interactive"
            bindtap="goToAbout"
          >
            <view class="menu-item-left">
              <van-icon name="info-o" class="menu-icon" />
              <text class="menu-text">关于我们</text>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <van-button
        type="default"
        block
        round
        size="large"
        custom-class="logout-btn"
        bind:click="handleLogout"
      >
        <van-icon name="logout" class="logout-icon" />
        退出登录
      </van-button>
    </view>

    <!-- 版本信息 -->
    <view class="version-section">
      <text class="version-text">版本 {{version}}</text>
    </view>
  </block>
</view>