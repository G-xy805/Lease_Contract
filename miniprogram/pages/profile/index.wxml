<!-- pages/profile/index.wxml - 个人中心页（v2重构版） -->
<view class="profile-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <van-loading type="spinner" size="60rpx" color="var(--primary-color)">加载中...</van-loading>
  </view>

  <block wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="card-bg"></view>
      <view class="user-info-content">
        <view class="avatar-wrapper">
          <view class="avatar-ring"></view>
          <van-image
            round
            width="140rpx"
            height="140rpx"
            src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}"
            class="avatar"
          />
        </view>
        <view class="user-details">
          <view class="name-row">
            <text class="nickname">{{userInfo.name || '未设置昵称'}}</text>
            <view class="role-tag {{currentRole === 'LESSOR' ? 'role-lessor' : currentRole === 'ADMIN' ? 'role-admin' : 'role-lessee'}}">
              <van-icon name="{{currentRole === 'LESSOR' ? 'home-o' : currentRole === 'ADMIN' ? 'setting-o' : 'user-o'}}" class="role-icon" />
              {{getRoleText(currentRole)}}
            </view>
          </view>
          <view class="phone-row">
            <van-icon name="phone-o" size="28rpx" class="phone-icon" />
            <text class="phone">{{userInfo.phone || '未绑定手机'}}</text>
          </view>
        </view>
      </view>

      <!-- 角色切换（仅当用户同时拥有两个角色时显示） -->
      <view class="role-switch" wx:if="{{userInfo.has_lessor_role && userInfo.has_lessee_role}}">
        <view
          class="role-btn {{currentRole === 'LESSOR' ? 'active' : ''}}"
          data-role="LESSOR"
          bindtap="switchRole"
        >
          甲方
        </view>
        <view
          class="role-btn {{currentRole === 'LESSEE' ? 'active' : ''}}"
          data-role="LESSEE"
          bindtap="switchRole"
        >
          乙方
        </view>
      </view>
    </view>

    <!-- 实名认证状态卡片 -->
    <view class="auth-card">
      <van-cell-group border="{{false}}" class="auth-group">
        <van-cell title="实名认证" center border="{{false}}">
          <!-- 未认证状态 -->
          <view wx:if="{{userInfo.real_name_status === REAL_NAME_STATUS.NOT_AUTH}}" slot="right-icon" class="auth-status">
            <status-tag type="default" text="未认证" size="small" />
            <van-button type="primary" size="small" round bindtap="goToRealNameAuth" class="auth-btn">
              去认证
            </van-button>
          </view>
          <!-- 认证中状态 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.AUTHENTICATING}}" slot="right-icon" class="auth-status">
            <van-loading size="32rpx" />
            <status-tag type="warning" text="认证中" size="small" />
          </view>
          <!-- 已认证状态 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.AUTHENTICATED}}" slot="right-icon" class="auth-status verified">
            <van-icon name="passed" size="36rpx" color="var(--success-color)" />
            <status-tag type="success" text="已认证" size="small" />
          </view>
          <!-- 认证失败状态 -->
          <view wx:elif="{{userInfo.real_name_status === REAL_NAME_STATUS.FAILED}}" slot="right-icon" class="auth-status">
            <status-tag type="danger" text="认证失败" size="small" />
            <van-button type="danger" size="small" round bindtap="goToRealNameAuth" class="auth-btn">
              重新认证
            </van-button>
          </view>
        </van-cell>
      </van-cell-group>
    </view>

    <!-- 功能菜单列表 -->
    <view class="menu-section">
      <view class="menu-card">
        <block wx:for="{{menuList}}" wx:key="group">
          <!-- 菜单组标题 -->
          <view class="menu-group-title">
            <van-icon name="{{item.icon}}" class="menu-group-icon" />
            <text>{{item.title}}</text>
          </view>

          <!-- 菜单项列表 -->
          <view
            wx:for="{{item.items}}"
            wx:for-item="menuItem"
            wx:key="id"
            class="menu-item interactive"
            bindtap="onMenuItemTap"
            data-id="{{menuItem.id}}"
          >
            <view class="menu-item-left">
              <van-icon name="{{menuItem.icon}}" class="menu-icon" />
              <view class="menu-item-info">
                <text class="menu-text">{{menuItem.title}}</text>
                <text class="menu-desc">{{menuItem.desc}}</text>
              </view>
            </view>
            <van-icon name="arrow" size="32rpx" color="var(--text-color-tertiary)" />
          </view>

          <!-- 分组分隔线（最后一个分组不显示） -->
          <view class="menu-divider" wx:if="{{index < menuList.length - 1}}"></view>
        </block>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <view class="logout-section">
      <van-button
        type="default"
        block
        round
        size="large"
        custom-class="logout-btn"
        bind:click="handleLogout"
      >
        <van-icon name="revoke" class="logout-icon" />
        退出登录
      </van-button>
    </view>

    <!-- 版本信息 -->
    <view class="version-section">
      <text class="version-text">版本 {{version}}</text>
    </view>
  </block>
</view>
