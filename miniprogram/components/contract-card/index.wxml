<view class="contract-card" bindtap="onTap">
  <!-- 头部：标题和状态标签 -->
  <view class="contract-card__header">
    <text class="contract-card__title">{{title}}</text>
    <status-tag status="{{status}}" size="sm" />
  </view>

  <!-- 主体内容 -->
  <view class="contract-card__body">
    <view class="contract-card__row">
      <text class="contract-card__label">地址</text>
      <text class="contract-card__value ellipsis">{{address}}</text>
    </view>

    <view class="contract-card__row">
      <text class="contract-card__label">月租金</text>
      <text class="contract-card__value price">¥{{monthlyRent}}</text>
    </view>

    <view class="contract-card__row">
      <text class="contract-card__label">甲方</text>
      <text class="contract-card__value">{{partyA}}</text>
    </view>

    <view class="contract-card__row" wx:if="{{partyB}}">
      <text class="contract-card__label">乙方</text>
      <text class="contract-card__value">{{partyB}}</text>
    </view>
  </view>

  <!-- 底部：创建时间 -->
  <view class="contract-card__footer" wx:if="{{createdAt}}">
    <text class="contract-card__time">{{createdAt}}</text>
  </view>
</view>
