/* contract-card 合同卡片组件样式 */

:host {
  display: block;
}

/* 卡片容器 */
.contract-card {
  background-color: var(--card-background);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-color);
  transition: transform var(--transition-normal) var(--ease-out),
              box-shadow var(--transition-normal) var(--ease-out),
              border-color var(--transition-normal) var(--ease-out);
}

/* 点击态效果 */
.contract-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
  border-color: var(--primary-color);
}

/* 头部区域 */
.contract-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-md);
}

/* 标题文字 */
.contract-card__title {
  flex: 1;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  margin-right: var(--spacing-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 主体内容区域 */
.contract-card__body {
  color: var(--text-color-secondary);
}

/* 信息行 */
.contract-card__row {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--spacing-xs);
}

.contract-card__row:last-child {
  margin-bottom: 0;
}

/* 标签文字 */
.contract-card__label {
  color: var(--text-color-tertiary);
  flex-shrink: 0;
  margin-right: var(--spacing-sm);
  min-width: 80rpx;
}

/* 值文字 */
.contract-card__value {
  flex: 1;
  color: var(--text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 文本省略 */
.contract-card__value.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 价格样式 - 使用主题色加粗 */
.contract-card__value.price {
  color: var(--danger-color);
  font-weight: 600;
  font-size: var(--font-size-md);
}

/* 底部区域 */
.contract-card__footer {
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border-color);
}

/* 时间文字 */
.contract-card__time {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}
