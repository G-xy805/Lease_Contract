.user-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.user-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.user-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

.user-card:active::after {
  border-color: #1989fa;
}

.avatar-wrapper {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f7f8fa;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1989fa 0%, #3994f5 100%);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 500;
}

.verification-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #07c160;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verification-badge .van-icon {
  color: #ffffff;
  font-size: 16rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-name-placeholder {
  color: #969799;
}

.role-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background-color: #f7f8fa;
  color: #646566;
}

.role-tag.lessor {
  background-color: #e6f4ff;
  color: #1989fa;
}

.role-tag.lessee {
  background-color: #fff7e6;
  color: #ff976a;
}

.user-phone {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 6rpx;
}

.user-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #c8c9cc;
}

.user-meta .meta-item {
  display: flex;
  align-items: center;
}

.user-meta .meta-dot {
  margin: 0 8rpx;
}

.arrow-icon {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #c8c9cc;
}

.arrow-icon .van-icon {
  font-size: 28rpx;
}
