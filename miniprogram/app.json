{
  "pages": [
    "pages/index/index",
    "pages/login/index",
    "pages/real-name/index",
    "pages/contracts/index",
    "pages/my-contracts/index",
    "pages/create-contract/index",
    "pages/preview-contract/index",
    "pages/sign-contract/index",
    "pages/contract-detail/index",
    "pages/profile/index",
    "pages/verify-invite/index"
  ],
  "window": {
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "租赁合同",
    "backgroundColor": "#f5f5f5",
    "backgroundTextStyle": "dark",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#1989fa",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/images/tab-home.png",
        "selectedIconPath": "assets/images/tab-home.png"
      },
      {
        "pagePath": "pages/my-contracts/index",
        "text": "我的合同",
        "iconPath": "assets/images/tab-contract.png",
        "selectedIconPath": "assets/images/tab-contract.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "assets/images/tab-profile.png",
        "selectedIconPath": "assets/images/tab-profile.png"
      }
    ]
  },
  "usingComponents": {
    "van-button": "@vant/weapp/button/index",
    "van-field": "@vant/weapp/field/index",
    "van-toast": "@vant/weapp/toast/index",
    "van-dialog": "@vant/weapp/dialog/index",
    "van-notify": "@vant/weapp/notify/index",
    "van-loading": "@vant/weapp/loading/index",
    "van-cell": "@vant/weapp/cell/index",
    "van-cell-group": "@vant/weapp/cell-group/index",
    "van-tag": "@vant/weapp/tag/index",
    "van-card": "@vant/weapp/card/index",
    "van-empty": "@vant/weapp/empty/index",
    "van-search": "@vant/weapp/search/index",
    "van-tabs": "@vant/weapp/tabs/index",
    "van-tab": "@vant/weapp/tab/index",
    "van-icon": "@vant/weapp/icon/index",
    "van-image": "@vant/weapp/image/index",
    "van-popup": "@vant/weapp/popup/index",
    "van-transition": "@vant/weapp/transition/index",
    "van-divider": "@vant/weapp/divider/index",
    "van-calendar": "@vant/weapp/calendar/index",
    "van-datetime-picker": "@vant/weapp/datetime-picker/index",
    "van-picker": "@vant/weapp/picker/index",
    "van-action-sheet": "@vant/weapp/action-sheet/index",
    "van-swipe-cell": "@vant/weapp/swipe-cell/index",
    "van-checkbox": "@vant/weapp/checkbox/index",
    "van-checkbox-group": "@vant/weapp/checkbox-group/index",
    "van-radio": "@vant/weapp/radio/index",
    "van-radio-group": "@vant/weapp/radio-group/index",
    "van-switch": "@vant/weapp/switch/index",
    "van-slider": "@vant/weapp/slider/index",
    "van-stepper": "@vant/weapp/stepper/index",
    "van-rate": "@vant/weapp/rate/index",
    "van-collapse": "@vant/weapp/collapse/index",
    "van-collapse-item": "@vant/weapp/collapse-item/index",
    "van-sidebar": "@vant/weapp/sidebar/index",
    "van-sidebar-item": "@vant/weapp/sidebar-item/index",
    "van-tree-select": "@vant/weapp/tree-select/index",
    "van-index-bar": "@vant/weapp/index-bar/index",
    "van-index-anchor": "@vant/weapp/index-anchor/index",
    "van-progress": "@vant/weapp/progress/index",
    "van-circle": "@vant/weapp/circle/index",
    "van-overlay": "@vant/weapp/overlay/index"
